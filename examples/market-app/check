#!/bin/sh
# The market's commands, Room DAOs and schema through the packaged runtime, and
# the applications' compilation. The multi-process scenarios are ./qualify.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)

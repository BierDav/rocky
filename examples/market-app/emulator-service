#!/bin/sh
# Starts three loopback voters as scripts/coordinator-local does, whose certified
# client addresses also name 10.0.2.2: the host's loopback as an Android emulator
# reaches it. The plan is certified again with a fresh root key that is deleted
# afterwards. Prints the bundle for the app. Stop it with: kill $(cat DIR/voter-*.pid)
# See docs/runtime/market-qualification.md#android-emulator.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
dir=${1:?usage: emulator-service DIR [BASE_PORT]}
port=${2:-7300}

cargo build --manifest-path "$repo_root/Cargo.toml" -p rocky-coordinator --bin rocky-voter --locked
voter="$repo_root/target/debug/rocky-voter"
"$voter" local "$dir" "$port" >/dev/null
"$voter" key "$dir/root.key" >/dev/null
python3 - "$dir/plan.json" <<'PY'
import json, sys
path = sys.argv[1]
plan = json.load(open(path))
for voter in plan["voters"]:
    client = json.loads(voter["client"])
    port = client["addrs"][0]["Ip"].rsplit(":", 1)[1]
    client["addrs"].append({"Ip": "10.0.2.2:" + port})
    voter["client"] = json.dumps(client, separators=(",", ":"))
json.dump(plan, open(path, "w"), indent=2)
PY
rm -r "$dir/service"
"$voter" certify "$dir/plan.json" "$dir/root.key" "$dir/service" >/dev/null
rm "$dir/root.key"
python3 - "$dir" <<'PY'
import json, os, sys
dir = sys.argv[1]
root = json.load(open(os.path.join(dir, "service/bundle.json")))["root"]
for name in ["admin.json"] + ["voter-%d.json" % id for id in (1, 2, 3)]:
    path = os.path.join(dir, name)
    config = json.load(open(path))
    config["trusted_root"] = root
    json.dump(config, open(path, "w"))
PY

for id in 1 2 3; do
    "$voter" "$dir/voter-$id.json" --provision >"$dir/voter-$id.log" 2>&1 &
    echo $! >"$dir/voter-$id.pid"
done
tries=0
until "$voter" admin "$dir/admin.json" initialize 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -gt 100 ]; then
        echo "voters did not come up; see $dir/voter-*.log" >&2
        exit 1
    fi
    sleep 0.1
done
echo "bundle: $dir/service/bundle.json"

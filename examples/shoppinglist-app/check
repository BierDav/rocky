#!/bin/sh
set -eu
app=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$app"
project=${ROCKY_SHOPPING_PROJECT:-$app}
# The scope's required definition installs by hand and from Room before anything else runs.
./kotlin run --project-dir "$project" -m qualification -- required-schema
./kotlin test --project-dir "$project" -p jvm -p android -m shared
./kotlin build --project-dir "$project" -m desktopApp
./kotlin build --project-dir "$project" -m androidApp

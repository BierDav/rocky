#!/usr/bin/env python3
"""Collect bounded diagnostic files only; never databases, keys or preferences."""
import argparse
from datetime import datetime, timezone
from pathlib import Path
import shutil
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--serial', help='Explicit ADB selector for david-pixel; omit for desktop only')
parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[2] / 'local/manual-testing')
parser.add_argument('--output', type=Path)
args = parser.parse_args()
out = args.output or args.root / ('collected-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
out.mkdir(parents=True, exist_ok=False)
for label in ('desktop-a', 'desktop-b'):
    source = args.root / label / 'logs'
    target = out / label
    target.mkdir()
    for suffix in ('', '.1', '.2', '.3'):
        path = source / ('diagnostics.log' + suffix)
        if path.is_file():
            shutil.copy2(path, target / path.name)
if args.serial:
    adb = ['adb', '-s', args.serial]
    name = subprocess.check_output(adb + ['shell', 'settings', 'get', 'global', 'device_name'], text=True).strip()
    if name != 'david-pixel':
        raise SystemExit(f'Refusing unexpected device name: {name}')
    target = out / 'david-pixel'
    target.mkdir()
    for suffix in ('', '.1', '.2', '.3'):
        path = 'files/diagnostics/diagnostics.log' + suffix
        exists = subprocess.run(adb + ['shell', 'run-as', 'org.example.examples', 'test', '-f', path], capture_output=True)
        if exists.returncode == 0:
            data = subprocess.check_output(adb + ['exec-out', 'run-as', 'org.example.examples', 'cat', path])
            (target / ('diagnostics.log' + suffix)).write_bytes(data)
        elif not suffix:
            raise SystemExit(f'Cannot read debug-app diagnostics: {exists.stderr.decode(errors="replace")}')
print(out)

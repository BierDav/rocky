<?xml version="1.0" encoding="UTF-8"?>
<!-- The launch screen; the app keeps the same view on top until its first settled screen draws. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lnc-VC-001">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="Lnc-SC-001">
            <objects>
                <viewController id="Lnc-VC-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Lnc-VW-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-IV-001">
                                <rect key="frame" x="148.5" y="378" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="Lnc-CW-001"/>
                                    <constraint firstAttribute="height" constant="96" id="Lnc-CH-001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="Lnc-IV-001" firstAttribute="centerX" secondItem="Lnc-VW-001" secondAttribute="centerX" id="Lnc-CX-001"/>
                            <constraint firstItem="Lnc-IV-001" firstAttribute="centerY" secondItem="Lnc-VW-001" secondAttribute="centerY" id="Lnc-CY-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lnc-FR-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchLogo" width="96" height="96"/>
        <namedColor name="LaunchBackground">
            <color red="0.5961" green="0.8314" blue="0.8902" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>

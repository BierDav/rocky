#!/bin/sh
# Build a desktop JAR another machine can run, and prove it from that JAR alone.
#
# `./kotlin package -m desktopApp -f executable-jar` writes every runtime
# dependency into BOOT-INF/lib under its bare file name. JetBrains publishes
# Compose, Lifecycle and SavedState twice: an empty relocation stub whose POM
# defers to the androidx artifact that actually holds the classes, plus that
# androidx artifact. Both files are called `runtime-desktop-1.12.1.jar`, so the
# flattening keeps one, drops the other, and the one it keeps is the stub. The
# packaged JAR then dies on startup with
# NoClassDefFoundError: androidx/compose/runtime/Composer, while `./kotlin run`
# starts normally because a classpath tells the two apart by full path.
#
# This script builds the JAR, adds the dropped artifacts back under names that
# cannot collide, and loads their classes through the finished JAR so a missing
# dependency fails here instead of on the other machine.
set -eu

die() {
    echo >&2 "package-desktop: $*" >&2
    exit 1
}

app=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$app"

natives=${ROCKY_DESKTOP_NATIVES:-$app/../../sdks/native/target/desktop-natives}
if [ -z "${ROCKY_DESKTOP_NATIVES:-}" ]; then
    "$app/../../sdks/native/build-desktop" "$natives"
fi
for resource in darwin-aarch64/librocky_uniffi.dylib darwin-x86-64/librocky_uniffi.dylib \
    linux-x86-64/librocky_uniffi.so linux-aarch64/librocky_uniffi.so win32-x86-64/rocky_uniffi.dll; do
    [ -s "$natives/$resource" ] || die "missing $natives/$resource"
done
natives=$(CDPATH='' cd -- "$natives" && pwd)

case $(uname -s) in
    Darwin*) default_cache=$HOME/Library/Caches/JetBrains/Kotlin ;;
    Linux*) default_cache=$HOME/.cache/JetBrains/Kotlin ;;
    *) die "unsupported platform $(uname -s)" ;;
esac
cache=${KOTLIN_CLI_SHARED_CACHE:-$default_cache}/.m2.cache
[ -d "$cache" ] || die "no Maven cache at $cache; run ./kotlin once first"

./kotlin package -m desktopApp -f executable-jar

built=build/tasks/_desktopApp_executableJarJvm/desktopApp-jvm-executable.jar
[ -f "$built" ] || die "Amper produced no $built"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
destination=$app/build/dist/shopping-desktop.jar
out=$work/shopping-desktop.jar
cp "$built" "$out"
chmod +w "$out"
stage=$work/stage
unzip -qq "$out" -d "$stage"

# Fully qualified names of the classes in a jar, without loading any of them.
list_classes() {
    unzip -l "$1" 2>/dev/null | awk '$4 ~ /\.class$/ { print $4 }' |
        sed 's/\.class$//; s|/|.|g'
}

class_count() {
    unzip -l "$1" 2>/dev/null | awk '$4 ~ /\.class$/ { n++ } END { print n + 0 }'
}

# A BOOT-INF/lib jar holding no classes is a relocation stub, or a native-only or
# Kotlin-only artifact. The same-named jar in the Maven cache that does hold
# classes is the one Amper's basename flattening dropped.
restored=0
inert=''
added=''
for stub in "$stage"/BOOT-INF/lib/*.jar; do
    [ -f "$stub" ] || continue
    [ "$(class_count "$stub")" -eq 0 ] || continue
    name=${stub##*/}

    real=''
    for candidate in $(find "$cache" -type f -name "$name" 2>/dev/null | sort); do
        if [ "$(class_count "$candidate")" -gt 0 ]; then real=$candidate; break; fi
    done
    if [ -z "$real" ]; then
        inert="$inert $name"
        continue
    fi

    # Prefix with the artifact's group id so both jars can share a directory.
    relative=${real#"$cache"/}
    group=$(echo "${relative%/*}" | sed 's|\(/[^/]*\)\{3\}$||' | tr / -)
    target=$stage/BOOT-INF/lib/$group-$name
    if [ -e "$target" ]; then
        inert="$inert $name"
        continue
    fi
    cp "$real" "$target"
    restored=$((restored + 1))
    added="$added ${target##*/}"
    echo "restored $name from ${relative%%/*}"
done

if [ "$restored" -eq 0 ]; then
    echo "no dropped dependencies; the JAR from Amper is already whole" >&2
fi

# Match Skiko's resolved API version, rather than maintaining another version pin.
set -- "$stage"/BOOT-INF/lib/skiko-awt-[0-9]*.jar
[ $# -eq 1 ] && [ -f "$1" ] || die "expected one skiko-awt API JAR"
version=${1##*/skiko-awt-}
version=${version%.jar}
native_cache=${KOTLIN_CLI_SHARED_CACHE:-$default_cache}/rocky-desktop-skiko
mkdir -p "$native_cache"
for platform in macos-arm64 macos-x64 linux-x64 linux-arm64 windows-x64; do
    name=skiko-awt-runtime-$platform-$version.jar
    artifact=skiko-awt-runtime-$platform
    cached=$native_cache/$name
    if [ ! -f "$cached" ]; then
        url=https://repo.maven.apache.org/maven2/org/jetbrains/skiko/$artifact/$version/$name
        curl --fail --location --retry 3 --silent --show-error "$url" -o "$work/$name"
        curl --fail --location --retry 3 --silent --show-error "$url.sha256" -o "$work/checksum"
        expected=$(cat "$work/checksum")
        actual=$(shasum -a 256 "$work/$name" | awk '{print $1}')
        [ "$expected" = "$actual" ] || die "checksum mismatch for $name"
        unzip -tqq "$work/$name"
        mv "$work/$name" "$cached"
    fi
    cp "$cached" "$stage/BOOT-INF/lib/$name"
    added="$added $name"
done

# Put each library at JNA's platform prefix in the existing runtime JAR.
set -- "$stage"/BOOT-INF/lib/rocky-core-jvm-*.jar
[ $# -eq 1 ] && [ -f "$1" ] || die "expected one rocky-core-jvm JAR"
runtime=$1
(cd "$natives" && zip -q "$runtime" \
    darwin-aarch64/librocky_uniffi.dylib darwin-x86-64/librocky_uniffi.dylib \
    linux-x86-64/librocky_uniffi.so linux-aarch64/librocky_uniffi.so win32-x86-64/rocky_uniffi.dll)

# Normalize Amper's comma-prefixed lines, keeping the first occurrence of each
# JAR in order. The manifest's JarLauncher requires one quoted entry per line.
cp "$stage/BOOT-INF/classpath.idx" "$work/classpath.idx"
for name in $added; do
    printf -- '- "BOOT-INF/lib/%s"\n' "$name" >> "$work/classpath.idx"
done
awk 'match($0, /"[^"]+"/) {
    entry = substr($0, RSTART, RLENGTH)
    if (!seen[entry]++) print "- " entry
}' "$work/classpath.idx" > "$stage/BOOT-INF/classpath.idx"

# Repack with every entry stored. The nested jars are already compressed, and
# Spring Boot reads BOOT-INF/lib without inflating it.
(cd "$stage" && zip -q -X -0 "$out" META-INF/MANIFEST.MF &&
    zip -q -X -0 -r "$out" . -x 'META-INF/MANIFEST.MF')

# Load the application's entry point and every class the recovered jars carry
# through the finished JAR, so anything still missing fails here.
cat > "$work/Verify.java" <<'EOF'
final class Verify {
    public static void main(String[] args) throws Exception {
        ClassLoader loader = Verify.class.getClassLoader();
        for (String resource : new String[] {
            "darwin-aarch64/librocky_uniffi.dylib", "darwin-x86-64/librocky_uniffi.dylib",
            "linux-x86-64/librocky_uniffi.so", "linux-aarch64/librocky_uniffi.so",
            "win32-x86-64/rocky_uniffi.dll",
            "libskiko-macos-arm64.dylib", "libskiko-macos-x64.dylib",
            "libskiko-linux-x64.so", "libskiko-linux-arm64.so", "skiko-windows-x64.dll"
        }) {
            if (loader.getResource(resource) == null) throw new IllegalStateException("Missing " + resource);
        }
        Class<?> skiko = Class.forName("org.jetbrains.skiko.Library", true, loader);
        skiko.getMethod("load").invoke(skiko.getField("INSTANCE").get(null));
        Class.forName("rocky.internal.native.UniffiLib", true, loader);
        Class.forName("rocky.internal.native.IntegrityCheckingUniffiLib", true, loader);
        int bad = 0;
        for (String name : args) {
            try {
                Class.forName(name, false, loader);
            } catch (Throwable t) {
                System.err.println("UNRESOLVED " + name + ": " + t);
                if (++bad > 5) { System.err.println("too many failures"); break; }
            }
        }
        System.out.println((args.length - bad) + "/" + args.length + " classes resolved");
        if (bad > 0) System.exit(1);
    }
}
EOF
verify=$work/verify
mkdir -p "$verify"
javac -d "$verify" "$work/Verify.java"

classes=$(
    (cd "$stage/BOOT-INF/lib" && find . -type f \( -name '*-runtime-*' -o -name '*-lifecycle-*' -o -name '*-savedstate-*' \) | sort) |
    while read -r name; do list_classes "$stage/BOOT-INF/lib/$name"; done
)
classes="$classes org.example.examples.MainKt"

echo "verifying $out"
# Class names are intentionally separate arguments.
# shellcheck disable=SC2086
java -Dloader.main=Verify -Dloader.path="$verify" -cp "$out" \
    org.springframework.boot.loader.launch.PropertiesLauncher $classes

# Exercise the manifest's actual launcher with the same libraries and index.
launcher=$work/launcher
mkdir -p "$launcher/META-INF" "$launcher/BOOT-INF/classes"
sed 's/^Start-Class: .*/Start-Class: Verify/' "$stage/META-INF/MANIFEST.MF" > "$launcher/META-INF/MANIFEST.MF"
cp "$verify/Verify.class" "$launcher/BOOT-INF/classes/Verify.class"
cp "$out" "$work/verify-launcher.jar"
(cd "$launcher" && zip -q -X -0 "$work/verify-launcher.jar" META-INF/MANIFEST.MF BOOT-INF/classes/Verify.class)
# shellcheck disable=SC2086
java -jar "$work/verify-launcher.jar" $classes

for name in $inert; do
    echo "note: $name carries no classes and has no same-named counterpart" >&2
done

mkdir -p "$(dirname -- "$destination")"
mv "$out" "$destination"
echo "wrote $destination"

#!/bin/sh
# Multi-process shopping qualification: device JVMs, the packaged rocky-peer
# custody launcher and, for the seal scenarios, three loopback rocky-voter
# processes. Evidence goes to $ROCKY_EVIDENCE (default local/shopping-qualification).
set -eu
app=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$app/../.." && pwd)
cd "$app"
# The custody peer is the packaged launcher; the application has no Rust source.
# A prebuilt one may be given as $ROCKY_PEER.
if [ -z "${ROCKY_PEER:-}" ]; then
    (cd "$repo_root" && cargo build --locked -p rocky-sdk --bin rocky-peer)
    ROCKY_PEER="$repo_root/target/debug/rocky-peer"
fi
# The coordination service's voters; a prebuilt one may be given as $ROCKY_VOTER.
if [ -z "${ROCKY_VOTER:-}" ]; then
    (cd "$repo_root" && cargo build --locked -p rocky-coordinator --bin rocky-voter)
    ROCKY_VOTER="$repo_root/target/debug/rocky-voter"
fi
ROCKY_PEER="$ROCKY_PEER" \
ROCKY_VOTER="$ROCKY_VOTER" \
ROCKY_EVIDENCE="${ROCKY_EVIDENCE:-$repo_root/local/shopping-qualification}" \
    ./kotlin run -m qualification --project-dir "${ROCKY_SHOPPING_PROJECT:-$app}"

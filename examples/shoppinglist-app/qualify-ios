#!/usr/bin/env python3
"""Single-simulator application procedure (e2e, 15 min excluding the build)."""
import argparse
import json
from pathlib import Path
import subprocess
import time
import uuid
from urllib.parse import urlencode

ROOT = Path(__file__).resolve().parents[2]
EVIDENCE = ROOT / "local/phase21-evidence"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--device", required=True, help="arm64 iOS simulator UDID")
    parser.add_argument("--bundle", required=True, type=Path, help="three-voter service bundle")
    args = parser.parse_args()
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    expectations = []

    def device(*command, absent_alert=False):
        invocation = ["agent-device", *command, "--platform", "ios", "--udid", args.device, "--session", "p21-simulator"]
        print(" ".join(invocation), flush=True)
        result = subprocess.run(invocation, cwd=ROOT, text=True, capture_output=True, timeout=60)
        with (EVIDENCE / "device.log").open("a") as log:
            log.write(result.stdout + result.stderr)
        if result.returncode:
            if absent_alert and "alert not found" in result.stdout + result.stderr:
                return ""
            raise RuntimeError(result.stdout + result.stderr)
        return result.stdout

    def open_link(url):
        # agent-device's iOS URL entry truncates long links; stage bounded pieces.
        if len(url) > 1800:
            group = uuid.uuid4().hex
            parts = [url[i:i + 400] for i in range(0, len(url), 400)]
            for index, part in enumerate(parts):
                open_link("rocky-shopping://drive-chunk?" + urlencode({"group": group, "index": index, "total": len(parts), "part": part}))
                if index + 1 < len(parts):
                    device("wait", "text", f"staged {group} {index}", "30000")
            return
        device("open", "org.example.rockyshopping", url)
        alert = device("alert", "get", absent_alert=True)
        if alert:
            if "Open in" not in alert or "Shopping" not in alert:
                raise RuntimeError("Unexpected link alert: " + alert)
            device("alert", "accept")

    def paste(identifier):
        device("click", 'id="' + identifier + '"', "--settle")
        alert = device("alert", "get", absent_alert=True)
        if alert:
            if "would like to paste" not in alert or not any(name in alert for name in ("Shopping", "Market")):
                raise RuntimeError("Unexpected paste alert: " + alert)
            device("click", 'label="Allow Paste"', "--settle")

    def input_ref(label):
        response = json.loads(device("snapshot", "--json"))
        nodes = response.get("data", response)["nodes"]
        fields = [node for node in nodes if node.get("kind") == "text-view" and node.get("label") == label]
        if len(fields) != 1:
            raise RuntimeError(f"expected one {label} input, found {fields}")
        return "@" + fields[0]["ref"]

    def expect(name, text):
        device("wait", "text", text, "30000")
        expectations.append({"name": name, "text": text, "at_seconds": time.monotonic() - started})

    def install(title, identifier):
        apps = list((ROOT / "build").rglob(f"{title}.app"))
        apps = [p for p in apps if "iphonesimulator" in str(p).lower()]
        if len(apps) != 1:
            raise RuntimeError(f"expected one simulator {title}.app, found {apps}")
        subprocess.run(["xcrun", "simctl", "uninstall", args.device, identifier], cwd=ROOT, check=False, capture_output=True)
        device("install", identifier, str(apps[0]))
        device("open", identifier, "--foreground")

    try:
        install("Shopping", "org.example.rockyshopping")
        expect("shopping setup opens", "Start a household")
        device("clipboard", "write", "simulator-paste-fallback")
        paste("Paste code")
        expect("shopping paste fallback fills the code field without crashing", "simulator-paste-fallback")
        setup = urlencode({"configure": "true", "transport": "iroh", "bundle": args.bundle.read_text(), "step": "configure"})
        open_link("rocky-shopping://drive?" + setup)
        expect("shopping pins the fixture service", "done configure")
        device("click", 'label="Start"', "--settle")
        expect("shopping installation opens", "Create your first list")
        url = "rocky-shopping://drive?online=false&list=Offline+groceries&add=Milk&step=offline-write"
        open_link(url)
        expect("offline write commits", "done offline-write")
        expect("offline row is visible", "Milk")
        device("home")
        device("open", "org.example.rockyshopping", "--foreground")
        expect("foreground keeps committed row", "Milk")
        device("open", "org.example.rockyshopping", "--relaunch", "--foreground")
        expect("process restart reopens committed row", "Milk")
        device("close")

        install("Market", "org.example.rockymarket")
        expect("market setup opens", "Coordination bundle")
        device("clipboard", "write", args.bundle.read_text())
        paste("Paste bundle")
        expect("market paste fills the service bundle", json.loads(args.bundle.read_text())["root"])
        paste("Paste bundle")
        device("click", 'label="Create market"', "--settle")
        expect("market installation opens", "No reservation yet")
        device("fill", input_ref("New listing"), "Bolt", "--settle")
        device("click", 'label="List"', "--settle")
        expect("mergeable listing is visible", "Bolt")
        device("click", 'label="Restock"', "--settle")
        expect("service confirms stock", "1 in stock")
        device("click", 'label="Reserve"', "--settle")
        expect("service confirms reservation", "Accepted: 0 left")
        device("home")
        device("open", "org.example.rockymarket", "--foreground")
        expect("market resumes its confirmed projection", "0 in stock")
        device("open", "org.example.rockymarket", "--relaunch", "--foreground")
        expect("market reopens confirmed hold", "1 confirmed holds, 1 items")
        device("close")
        elapsed = time.monotonic() - started
        if elapsed > 900:
            raise RuntimeError(f"e2e suite exceeded 15 min: {elapsed:.2f} s")
        (EVIDENCE / "simulator.json").write_text(json.dumps({"passed": True, "device": args.device, "seconds": elapsed, "expectations": expectations}, indent=2) + "\n")
    except Exception as error:
        (EVIDENCE / "simulator.json").write_text(json.dumps({"passed": False, "device": args.device, "error": str(error), "expectations": expectations}, indent=2) + "\n")
        raise


if __name__ == "__main__":
    main()

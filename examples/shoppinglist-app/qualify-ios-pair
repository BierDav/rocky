#!/usr/bin/env python3
"""Simulator/Android emulator acceptance: roster-free pairing, custody delivery, sharing and revocation."""
import argparse
import base64
import json
from pathlib import Path
import selectors
import queue
import threading
import socket
import subprocess
import time
from urllib.parse import urlencode
import uuid

APP = Path(__file__).resolve().parent
ROOT = APP.parents[1]
OUT = ROOT / "local/phase21-evidence/pair"


def run(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT, timeout=60)


class Mobile:
    def __init__(self, platform, device, package):
        self.platform, self.device, self.package = platform, device, package
        self.notes = []
        self.active = False
        self.reverse_ports = []

    def call(self, *args, absent_alert=False):
        if self.platform == "android":
            for port in self.reverse_ports:
                run("adb", "-s", self.device, "reverse", f"tcp:{port}", f"tcp:{port}")
        command = ("agent-device", *args, "--platform", self.platform, "--udid" if self.platform == "ios" else "--serial", self.device, "--session", "p21-simulator" if self.platform == "ios" else "p21-android", "--json")
        print(" ".join(command), flush=True)
        try:
            output = run(*command)
        except subprocess.CalledProcessError as error:
            with (OUT / (self.platform + ".log")).open("a") as log:
                log.write(error.output)
            print(error.output, flush=True)
            if absent_alert and "ALERT_NOT_FOUND" in error.output:
                return {"data": None}
            raise
        with (OUT / (self.platform + ".log")).open("a") as log:
            log.write(output)
        if args[0] == "open":
            self.active = True
        elif args[0] == "close":
            self.active = False
        return json.loads(output)

    def expect(self, name, text):
        self.call("wait", "text", text, "30000")
        self.notes.append({"name": name, "text": text})

    def read(self, identifier):
        response = self.call("get", "text", 'id="' + identifier + '"')
        data = response.get("data", response)
        # `get text` carries the exact element text; refuse an unknown shape.
        if isinstance(data, str):
            return data
        for key in ("text", "value"):
            if isinstance(data.get(key), str):
                return data[key]
        raise RuntimeError("get text returned no text: " + repr(response))

    def invitation(self):
        if self.platform == "ios":
            return self.read("pairing-invitation")
        # Android dialogs have their own Compose root and do not inherit resource IDs.
        snapshot = self.call("snapshot")
        nodes = snapshot.get("data", snapshot)["nodes"]
        codes = [node for node in nodes if node.get("kind") == "text" and node.get("label", "").startswith("rocky://join/")]
        if len(codes) != 1:
            raise RuntimeError(f"expected one pairing invitation, found {codes}")
        response = self.call("get", "text", "@" + codes[0]["ref"])
        data = response.get("data", response)
        return data if isinstance(data, str) else data["text"]

    def open_link(self, url):
        if self.platform == "ios" and len(url) > 1800:
            group = uuid.uuid4().hex
            parts = [url[i:i + 400] for i in range(0, len(url), 400)]
            for index, part in enumerate(parts):
                self.open_link("rocky-shopping://drive-chunk?" + urlencode({"group": group, "index": index, "total": len(parts), "part": part}))
                if index + 1 < len(parts):
                    self.expect("link chunk staged", f"staged {group} {index}")
            return
        self.call("open", self.package, url)
        if self.platform == "ios":
            alert = self.call("alert", "get", absent_alert=True)
            if alert.get("data") is not None:
                if "Open in" not in json.dumps(alert) or "Shopping" not in json.dumps(alert):
                    raise RuntimeError("Unexpected link alert: " + repr(alert))
                self.call("alert", "accept")

    def drive(self, **parameters):
        marker = uuid.uuid4().hex
        parameters["step"] = marker
        self.open_link("rocky-shopping://drive?" + urlencode(parameters))
        self.expect("driver commits " + marker, "done " + marker)
        return self.read("qualification-result").splitlines()

    def fresh(self, artifact):
        if self.active:
            self.call("close")
        if self.platform == "ios":
            # Only this example is removed; never reset a simulator or its settings.
            subprocess.run(["xcrun", "simctl", "uninstall", self.device, self.package], cwd=ROOT, check=False, capture_output=True)
        else:
            subprocess.run(["adb", "-s", self.device, "uninstall", self.package], cwd=ROOT, check=False, capture_output=True)
        self.call("install", self.package, str(Path(artifact).resolve()))
        self.call("open", self.package, "--foreground")

    def click(self, label):
        if self.platform == "ios":
            snapshot = self.call("snapshot")
            nodes = snapshot.get("data", snapshot)["nodes"]
            buttons = [node for node in nodes if node.get("kind") == "button" and node.get("label") == label]
            if len(buttons) != 1:
                raise RuntimeError(f"expected one {label} button, found {buttons}")
            self.call("click", "@" + buttons[0]["ref"], "--settle")
        else:
            self.call("click", 'label="' + label + '"', "--settle")

    def fill(self, label, value):
        if self.platform == "ios":
            snapshot = self.call("snapshot")
            nodes = snapshot.get("data", snapshot)["nodes"]
            fields = [node for node in nodes if node.get("kind") == "text-view" and node.get("label") == label]
            if len(fields) != 1:
                raise RuntimeError(f"expected one {label} input, found {fields}")
            self.call("fill", "@" + fields[0]["ref"], value, "--settle")
        else:
            self.call("fill", 'label="' + label + '"', value, "--settle")



class Host:
    def __init__(self):
        self.process = subprocess.Popen([str(APP / "kotlin"), "run", "-m", "qualification", "--main-class", "org.example.examples.shopping.qualification.DeviceKt"], cwd=APP, text=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=(OUT / "host.log").open("w"), bufsize=1)

        self.lines = queue.Queue()
        def reader():
            for line in self.process.stdout:
                self.lines.put(line)
            self.lines.put(None)
        threading.Thread(target=reader, daemon=True).start()

    def request(self, op, **fields):
        self.process.stdin.write(json.dumps({"op": op, **fields}) + "\n")
        self.process.stdin.flush()
        while True:
            line = self.lines.get(timeout=60)
            if not line:
                raise RuntimeError("host exited during " + op)
            if line.startswith("@@rocky-device@@ "):
                result = json.loads(line.removeprefix("@@rocky-device@@ "))
                if "error" in result:
                    raise RuntimeError(result["error"])
                return result["ok"]

    def close(self):
        if self.process.poll() is None:
            self.request("close")
            self.process.wait(timeout=30)


def free_port():
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def emulator_contact(contact, android, forwards):
    prefix = "rocky://peer/"
    if not contact.startswith(prefix):
        raise RuntimeError("unexpected contact URI")
    encoded = contact.removeprefix(prefix)
    value = json.loads(base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)))
    if value.get("v") != 2:
        raise RuntimeError("unsupported contact version")
    for route in value["routes"]:
        if route["transport"] != "tcp":
            continue
        guest_port = int(route["address"].rsplit(":", 1)[1])
        host_port = free_port()
        run("adb", "-s", android.device, "forward", "--no-rebind", f"tcp:{host_port}", f"tcp:{guest_port}")
        forwards.append(host_port)
        route["address"] = f"127.0.0.1:{host_port}"
        android.notes.append({"name": "custody can reach the emulator listener", "text": route["address"]})
    return prefix + base64.urlsafe_b64encode(json.dumps(value, separators=(",", ":")).encode()).decode().rstrip("=")


def reverse_contact(contact, android, owned):
    # The simulator listens on host loopback; the emulator reaches it through adb reverse.
    encoded = contact.removeprefix("rocky://peer/")
    value = json.loads(base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)))
    for route in value["routes"]:
        if route["transport"] == "tcp":
            port = int(route["address"].rsplit(":", 1)[1])
            android.reverse_ports.append(port)
            owned.append(port)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("ios-device", "android-device", "ios-shopping", "android-shopping", "peer"):
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args()
    OUT.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    ios = Mobile("ios", args.ios_device, "org.example.rockyshopping")
    android = Mobile("android", args.android_device, "org.example.examples")
    host, custody = None, None
    forwards = []
    reverse_owned = []
    passed = False
    failure = None
    try:
        ios.fresh(args.ios_shopping)
        android.fresh(args.android_shopping)
        host = Host()
        port = free_port()
        created = host.request("create", directory=str(OUT / ("host-" + uuid.uuid4().hex)), listen="127.0.0.1:" + str(port))
        host_node = created["node"]
        android.reverse_ports.append(port)
        reverse_owned.append(port)
        run("adb", "-s", args.android_device, "reverse", f"tcp:{port}", f"tcp:{port}")
        contacts = {}
        for mobile in (ios, android):
            invitation = host.request("pairing", profile="issuer" if mobile.platform == "ios" else "writer")
            lines = mobile.drive(invitation=invitation, transport="tcp", contact="1", sync="1")
            contact = next(line.removeprefix("contact ").split(" ", 1) for line in lines if line.startswith("contact "))
            contacts[mobile.platform] = contact
        contacts["android"][1] = emulator_contact(contacts["android"][1], android, forwards)
        # Both issuer registries receive the second enrollment before the host stops.
        ios.drive(sync="1")
        android.drive(sync="1")
        custody_port = free_port()
        config = {
            "directory": str(OUT / ("custody-" + uuid.uuid4().hex)),
            "schema": host.request("schema"),
            "transport": {"kind": "tcp", "listen": f"127.0.0.1:{custody_port}"},
            "invitation": host.request("pairing", profile="custody"),
            "peers": [host.request("contact")["uri"], *[contact[1] for contact in contacts.values()]],
        }
        config_path = OUT / "peer.json"
        config_path.write_text(json.dumps(config))
        custody = subprocess.Popen([args.peer, str(config_path)], cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=(OUT / "custody.log").open("w"))
        selector = selectors.DefaultSelector()
        selector.register(custody.stdout, selectors.EVENT_READ)
        if not selector.select(30):
            raise RuntimeError("custody did not publish its contact")
        custody_contact = custody.stdout.readline().strip()
        if not custody_contact.startswith("rocky://peer/"):
            raise RuntimeError("unexpected custody contact: " + custody_contact)
        android.reverse_ports.append(custody_port)
        reverse_owned.append(custody_port)
        run("adb", "-s", args.android_device, "reverse", f"tcp:{custody_port}", f"tcp:{custody_port}")
        for mobile in (ios, android):
            mobile.drive(peer=custody_contact, forget=host_node, sync="1")
        ios.drive(add="Before background", list="Offline groceries", share="Offline groceries", to=contacts["android"][0])
        # Establish the shared list before the offline/background acceptance slice.
        ios.drive(sync="1")
        android.drive(sync="1")
        ios.expect("shared list exists before disconnecting", "Offline groceries")
        android.expect("shared list arrives before disconnecting", "Offline groceries")
        host.close()
        android.reverse_ports.remove(port)
        android.drive(online="false")
        ios.drive(online="false", add="Milk", list="Offline groceries")
        ios.expect("simulator committed the offline row", "Milk")
        # Restore configured connectivity with automatic sync already paused, then
        # use the real application visibility notification for the resume.
        ios.drive(background="true", online="true")
        ios.call("home")
        android.drive(online="true")
        android.call("wait", "absent", 'label="Milk"', "1000")
        android.notes.append({"name": "row is absent before simulator foreground", "text": "Milk absent"})
        ios.call("open", ios.package, "--foreground")
        android.expect("foreground automatically delivers the offline row through custody", "Milk")
        ios.expect("foreground keeps the committed local row", "Milk")
        # The member scans the trusted simulator's contact; it reads no registry.
        ios_node, ios_contact = contacts["ios"]
        reverse_contact(ios_contact, android, reverse_owned)
        shared = android.drive(share="Offline groceries", recipientContact=ios_contact, sync="1")
        if "share " + ios_node not in shared:
            raise RuntimeError("member share by scanned contact failed: " + repr(shared))
        android.notes.append({"name": "member shares by scanned contact", "text": "share " + ios_node})
        ios.drive(revoke=contacts["android"][0], sync="1")
        revoked = android.drive(sync="1")
        if not any(line.startswith("sync Revoked") for line in revoked):
            raise RuntimeError("member did not report revocation: " + repr(revoked))
        android.notes.append({"name": "trusted simulator revokes the member through custody", "text": "sync Revoked"})
        for mobile in (ios, android):
            mobile.call("close")
        custody.terminate()
        custody.wait(timeout=30)
        custody = None
        android.reverse_ports.clear()
        elapsed = time.monotonic() - started
        if elapsed > 900:
            raise RuntimeError(f"pair e2e suite exceeded 15 min: {elapsed:.2f} s")
        passed = True
    except Exception as error:
        failure = str(error)
        # Diagnostics run after failure and cannot turn the acceptance result green.
        for mobile in (ios, android):
            if not mobile.active:
                continue
            try:
                lines = mobile.drive(dump="1", status="1", sync="1", events="1")
                (OUT / (mobile.platform + "-failure-diagnostics.json")).write_text(json.dumps(lines, indent=2) + "\n")
            except Exception as diagnostic_error:
                print("Failure diagnostics: " + str(diagnostic_error), flush=True)
        raise
    finally:
        for port in reverse_owned:
            run("adb", "-s", android.device, "reverse", "--remove", f"tcp:{port}")
        for port in forwards:
            run("adb", "-s", android.device, "forward", "--remove", f"tcp:{port}")
        if host is not None:
            host.close()
        if custody is not None:
            custody.terminate()
            custody.wait(timeout=30)
        (OUT / "expectations-shopping.json").write_text(json.dumps({"passed": passed, "scenario": "shopping", "error": failure, "seconds": time.monotonic() - started, "ios": ios.notes, "android": android.notes}, indent=2) + "\n")


if __name__ == "__main__":
    main()

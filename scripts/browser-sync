#!/bin/sh
# A browser node syncs with a native node over a local iroh relay.
#
#   scripts/browser-sync [CARGO ARGS]
#                           start the native side (rocky-sdk example browser_peer),
#                           run rocky-sdk's browser_sync test in a headless browser
#                           with its relay and invitation, then let the native
#                           side check the browser's write
#
# scripts/check --wasm runs it after the wasm32 tests, with their packages
# (`-p ...`, default `-p rocky-sdk`), so the browser test shares their build.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# The native side links against the workspace test build, which a full
# check has already compiled, instead of a separate dev-profile build;
# ROCKY_NATIVE_TARGET_DIR names that build's directory when the wasm32 tests
# build elsewhere.
peer=$(CARGO_TARGET_DIR=${ROCKY_NATIVE_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_root/target}} \
    cargo test --locked --no-run --workspace --example browser_peer \
    --message-format json-render-diagnostics |
    sed -n 's/.*"name":"browser_peer".*"executable":"\([^"]*\)".*/\1/p')
[ -x "$peer" ] || { echo "browser-sync: the native side did not build" >&2; exit 1; }
work=$(mktemp -d)
peer_pid=
cleanup() {
    [ -n "$peer_pid" ] && kill "$peer_pid" 2>/dev/null || true
    rm -rf "$work"
}
trap cleanup EXIT INT TERM
mkfifo "$work/input" "$work/output"
"$peer" <"$work/input" >"$work/output" &
peer_pid=$!
# Holds the native side's stdin open until the browser is done.
exec 3>"$work/input"
# The native side's first line names its relay and invitation once both are
# ready. The read waits for that line however loaded the host is, and returns
# nothing if the native side ends first.
exec 4<"$work/output"
IFS= read -r ready <&4 || ready=
[ -n "$ready" ] || { echo "browser-sync: the native side ended before it was ready" >&2; exit 1; }

# The runner's deadline covers loading the test binary into the browser and
# the whole sync over the relay; as in scripts/wasm-tests, it only catches a
# hung browser, so a loaded host cannot fail a test that is still progressing.
: "${WASM_BINDGEN_TEST_TIMEOUT:=1800}"
export WASM_BINDGEN_TEST_TIMEOUT

[ "$#" -gt 0 ] || set -- -p rocky-sdk
ROCKY_BROWSER_PEER=$ready cargo test --locked \
    --target wasm32-unknown-unknown "$@" --test browser_sync
echo finished >&3
exec 3>&-
wait "$peer_pid"
peer_pid=
exec 4<&-

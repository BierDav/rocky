#!/bin/sh
# Workspace and scoped validation.
#
#   scripts/check                   formatting, clippy, the unit and integration tiers
#   scripts/check --unit            the unit tier of the workspace build: the edit loop,
#                                   on LLVM; ROCKY_CRANELIFT=1 opts into its separate build
#   scripts/check --package NAME    package and transitive workspace consumers
#   scripts/check --changed         scope to jj's current change; unknown inputs run everything
#   scripts/check --integration     only the integration tier
#   scripts/check --e2e             only the e2e tier, which CI runs, soak tests included
#   scripts/check --doc             also the doc tests
#   scripts/check --build DIR       clippy, then archive the test binaries in DIR
#   scripts/check [TIER] --from DIR the same checks with DIR's test binaries,
#                                   without clippy, which --build ran
#   scripts/check --no-clippy       the tests without clippy, when --build already
#                                   ran clippy but its archives are gone
#
# Tiers combine, as in `--unit --integration`. scripts/test-tiers enforces each
# tier's budgets. CI builds once with --build and runs the tiers --from its archives.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

tiers=
build=
archives=
clippy=true
doc=false
packages=
changed=
while [ $# -gt 0 ]; do
    case "$1" in
    --unit | --integration | --e2e) tiers="$tiers ${1#--}" ;;
    --package | -p) [ -n "${2:-}" ] || usage; packages="$packages $2"; shift ;;
    --changed) changed=--changed ;;
    --build) build=true && archives=${2:-} && shift ;;
    --from) archives=${2:-} && shift ;;
    --no-clippy) clippy=false ;;
    --doc) doc=true ;;
    *) usage ;;
    esac
    shift
done
[ -z "$build" ] || [ -n "$archives" ] || usage
# Archives always contain the complete validation matrix.
[ -z "$archives" ] || { [ -z "$packages" ] && [ -z "$changed" ]; } || usage
selection='all()'
if [ -n "$packages$changed" ]; then
    # shellcheck disable=SC2086 # workspace package names are separate arguments
    selection=$(scripts/check-scope $changed $packages)
fi

cargo nextest --version >/dev/null 2>&1 || {
    echo "check: install cargo-nextest (https://nexte.st)" >&2
    exit 1
}

# The two builds of the tests: the workspace, and the SDK without iroh, since
# the database, sessions and other transports must not need it.
archive_args() { # name
    case "$1" in
    workspace) echo --workspace ;;
    sdk-without-defaults) echo -p rocky-sdk --no-default-features ;;
    esac
}

run_tiers() { # tiers...
    if [ -n "$archives" ]; then
        scripts/test-tiers "$@" --archive "$archives/workspace.tar.zst" \
            --archive "$archives/sdk-without-defaults.tar.zst"
    else
        case "$selection" in
        'all()' | *'package(=rocky-sdk)'*)
            scripts/test-tiers "$@" --filter "$selection" --build=--workspace \
                "--build=$(archive_args sdk-without-defaults)" ;;
        *) scripts/test-tiers "$@" --filter "$selection" --build=--workspace ;;
        esac
    fi
}

if [ -n "$build" ]; then
    cargo clippy --workspace --all-targets --locked -- -D warnings
    # nextest cannot archive doc tests; --doc runs them here, where the workspace
    # is already compiled, so a later --from needs no compile.
    if $doc; then
        cargo test --workspace --doc --locked
    fi
    mkdir -p "$archives"
    for name in workspace sdk-without-defaults; do
        # shellcheck disable=SC2046 # the build arguments are words
        cargo nextest archive --locked $(archive_args "$name") \
            --archive-file "$archives/$name.tar.zst"
        if [ "$name" = workspace ]; then
            # nextest built the peer for integration tests; the next feature build replaces it.
            cp "${CARGO_TARGET_DIR:-target}/debug/rocky-peer" "$archives/rocky-peer"
        fi
    done
    exit
fi

# Keep workspace feature unification even for scoped tests: package builds
# can grow a second set of dependency artifacts. Reuse the full check's LLVM build.
# Cranelift remains an explicit opt-in. Unit tiers contain library and binary
# tests; kind(test) targets belong to integration/e2e and need not be built here.
if [ "$tiers" = " unit" ] && [ -z "$archives" ] && ! $doc; then
    if [ "${ROCKY_CRANELIFT:-0}" = 1 ] && scripts/cranelift installed; then
        exec scripts/test-tiers unit --cranelift --filter "$selection" "--build=--workspace --lib --bins"
    fi
    exec scripts/test-tiers unit --filter "$selection" "--build=--workspace --lib --bins"
fi
if [ -z "$tiers" ]; then
    tiers="unit integration"
    cargo fmt --all -- --check
    if [ -z "$archives" ] && $clippy; then
        cargo clippy --workspace --all-targets --locked -- -D warnings
    fi
fi
# Every tier runs, so one failure does not hide another's.
status=0
# shellcheck disable=SC2086 # tiers are fixed names, not shell expressions
run_tiers $tiers || status=1
# nextest skips doc tests, which are opt-in so a check does not compile them.
if $doc; then
    cargo test --workspace --doc --locked || status=1
fi
exit $status

#!/bin/sh
# Shared checks. `--slow` runs only the ignored `soak_` tests instead.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# nextest runs every test binary in parallel; cargo test runs them in sequence.
nextest=false
if cargo nextest --version >/dev/null 2>&1; then
    nextest=true
fi
profile=${NEXTEST_PROFILE:-default}

if [ "${1:-}" = --slow ]; then
    if $nextest; then
        cargo nextest run --workspace --locked --profile "$profile" \
            --run-ignored only -E 'test(/::soak_/)'
    else
        cargo test --workspace --locked -- --ignored ::soak_
    fi
    exit
fi

run_tests() {
    if $nextest; then
        cargo nextest run --locked --profile "$profile" "$@"
    else
        cargo test --locked "$@"
    fi
}

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
run_tests --workspace
# nextest does not run doc tests.
if $nextest; then
    cargo test --workspace --doc --locked
fi
# The database, sessions and other transports must not need iroh.
run_tests -p rocky-sdk --no-default-features

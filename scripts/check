#!/bin/sh
# Workspace and scoped validation.
#
#   scripts/check                   formatting, clippy, the unit and integration tiers
#   scripts/check --all             formatting, clippy, and every test tier
#   scripts/check --unit            the unit tier of the workspace build: the edit loop,
#                                   on LLVM; ROCKY_CRANELIFT=1 opts into its separate build
#   scripts/check --package NAME    package and transitive workspace consumers
#   scripts/check --changed         scope to jj's current change; unknown inputs run everything
#   scripts/check --integration     only the integration tier
#   scripts/check --e2e             only the e2e tier, which CI runs, soak tests included,
#                                   and every tier of the SDK built without iroh
#   scripts/check --doc             also the doc tests
#   scripts/check --wasm            only wasm32: clippy, then the tests in a headless browser
#                                   and scripts/browser-sync; the full check includes it,
#                                   and --package or --changed scope its tests
#   scripts/check --build DIR       clippy, then archive the test binaries in DIR
#   scripts/check [TIER] --from DIR the same checks with DIR's test binaries,
#                                   without clippy, which --build ran
#   scripts/check --no-clippy       the tests without clippy, when --build already
#                                   ran clippy but its archives are gone
#
# Tiers combine, as in `--unit --integration`. scripts/test-tiers enforces each
# tier's correctness checks. CI builds once with --build and runs the tiers --from its archives.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

tiers=
build=
archives=
clippy=true
doc=false
wasm=false
wasm_only=false
all=false
packages=
changed=
while [ $# -gt 0 ]; do
    case "$1" in
    --all) all=true; tiers=" unit integration e2e" ;;
    --unit | --integration | --e2e) tiers="$tiers ${1#--}" ;;
    --package | -p) [ -n "${2:-}" ] || usage; packages="$packages $2"; shift ;;
    --changed) changed=--changed ;;
    --build) build=true && archives=${2:-} && shift ;;
    --from) archives=${2:-} && shift ;;
    --no-clippy) clippy=false ;;
    --doc) doc=true ;;
    --wasm) wasm_only=true ;;
    *) usage ;;
    esac
    shift
done
[ -z "$build" ] || [ -n "$archives" ] || usage
# --wasm adds wasm32 to the tiers, or alone runs only it. The full check,
# unscoped and without archives, covers wasm32 too.
wasm=$wasm_only
if ! $wasm_only && { [ -z "$tiers" ] || $all; } && [ -z "$packages$changed$archives" ]; then
    wasm=true
fi
# Archives always contain the complete validation matrix.
[ -z "$archives" ] || { [ -z "$packages" ] && [ -z "$changed" ]; } || usage
# Reject formatting before metadata, nextest discovery or compilation.
if { [ -z "$tiers" ] || $all; } && [ -z "$build" ]; then
    cargo fmt --all -- --check
fi
selection='all()'
if [ -n "$packages$changed" ]; then
    # shellcheck disable=SC2086 # workspace package names are separate arguments
    selection=$(scripts/check-scope $changed $packages)
fi

# wasm32 is the browser target. Each package's tests run in a dedicated Worker
# in a headless browser (scripts/wasm-runner); tests that need threads,
# processes, sockets or a paused clock are native-only. Clippy for wasm32 also
# refuses calls that panic or fail in a browser (scripts/clippy-wasm).
wasm_packages="rocky-platform rocky-sqlite rocky-sqlite-opfs rocky-core rocky-credentials rocky-storage
    rocky-runtime rocky-secure rocky-iroh rocky-coordinator rocky-sdk"
run_wasm() {
    set --
    for package in $wasm_packages; do set -- "$@" -p "$package"; done
    CLIPPY_CONF_DIR="$repo_root/scripts/clippy-wasm" cargo clippy --locked \
        --target wasm32-unknown-unknown --tests "$@" -- -D warnings
    # The binaries run at once, each in its own browser; large ones in shards.
    # A scope runs its packages' binaries of the same build. Meanwhile a
    # browser node syncs with a native node over a local relay
    # (scripts/browser-sync), when the SDK is in scope.
    only=
    sync=--browser-sync
    if [ "$selection" != 'all()' ]; then
        sync=
        for package in $wasm_packages; do
            case "$selection" in *"package(=$package)"*)
                only="$only --only $package"
                [ "$package" != rocky-sdk ] || sync=--browser-sync ;;
            esac
        done
        [ -n "$only" ] || { echo "check: no wasm32 package in scope" >&2; return 0; }
    fi
    # shellcheck disable=SC2086 # options are separate words
    "$repo_root/scripts/wasm-tests" $only $sync "$@"
}
if $wasm_only && [ -z "$tiers" ]; then
    run_wasm
    exit
fi

cargo nextest --version >/dev/null 2>&1 || {
    echo "check: install cargo-nextest (https://nexte.st)" >&2
    exit 1
}

# The two builds of the tests: the workspace, and the SDK without iroh, since
# the database, sessions and other transports must not need it. Only the
# iroh branches differ between them, so the gate compiles every target of
# the second; the e2e tier, which CI runs on each push to main, runs its tests.
archive_args() { # name
    case "$1" in
    workspace) echo --workspace ;;
    sdk-without-defaults) echo -p rocky-sdk --no-default-features ;;
    esac
}

run_tiers() { # tiers...
    e2e=false
    case " $* " in *' e2e '*) e2e=true ;; esac
    if [ -n "$archives" ]; then
        result=0
        scripts/test-tiers "$@" --archive "$archives/workspace.tar.zst" || result=1
        if $e2e; then
            scripts/test-tiers unit integration e2e \
                --archive "$archives/sdk-without-defaults.tar.zst" || result=1
        fi
        return $result
    fi
    sdk=false
    case "$selection" in
    'all()' | *'package(=rocky-sdk)'*) sdk=true ;;
    esac
    if $sdk && ! $e2e; then
        # shellcheck disable=SC2046 # the build arguments are words
        cargo check --locked --all-targets $(archive_args sdk-without-defaults) || return
    fi
    result=0
    scripts/test-tiers "$@" --filter "$selection" --build=--workspace || result=1
    if $sdk && $e2e; then
        scripts/test-tiers unit integration e2e --filter "$selection" \
            "--build=$(archive_args sdk-without-defaults)" || result=1
    fi
    return $result
}

if [ -n "$build" ]; then
    cargo clippy --workspace --all-targets --locked -- -D warnings
    # nextest cannot archive doc tests; --doc runs them here, where the workspace
    # is already compiled, so a later --from needs no compile.
    if $doc; then
        cargo test --workspace --doc --locked
    fi
    mkdir -p "$archives"
    for name in workspace sdk-without-defaults; do
        # shellcheck disable=SC2046 # the build arguments are words
        cargo nextest archive --locked $(archive_args "$name") \
            --archive-file "$archives/$name.tar.zst"
    done
    exit
fi

# Keep workspace feature unification even for scoped tests: package builds
# can grow a second set of dependency artifacts. Reuse the full check's LLVM build.
# Cranelift remains an explicit opt-in. Unit tiers contain library and binary
# tests; kind(test) targets belong to integration/e2e and need not be built here.
if [ "$tiers" = " unit" ] && [ -z "$archives" ] && ! $doc && ! $wasm; then
    if [ "${ROCKY_CRANELIFT:-0}" = 1 ] && scripts/cranelift installed; then
        exec scripts/test-tiers unit --cranelift --filter "$selection" "--build=--workspace --lib --bins"
    fi
    exec scripts/test-tiers unit --filter "$selection" "--build=--workspace --lib --bins"
fi
if [ -z "$tiers" ] || $all; then
    [ -n "$tiers" ] || tiers="unit integration"
    if [ -z "$archives" ] && $clippy; then
        cargo clippy --workspace --all-targets --locked -- -D warnings
    fi
fi
# The tiers share one RAM-backed directory for test storage
# (scripts/test-volume), removed when the check ends.
if [ -n "$tiers" ] && [ -z "${ROCKY_TEST_TMPDIR:-}" ]; then
    ROCKY_TEST_TMPDIR=$(scripts/test-volume up $$)
    export ROCKY_TEST_TMPDIR
    trap 'scripts/test-volume down "$ROCKY_TEST_TMPDIR" $$' EXIT
    trap 'exit 130' INT TERM
fi
# Every tier runs, so one failure does not hide another's.
status=0
# shellcheck disable=SC2086 # tiers are fixed names, not shell expressions
run_tiers $tiers || status=1
if $wasm; then
    run_wasm || status=1
fi
# nextest skips doc tests, which are opt-in so a check does not compile them.
if $doc; then
    cargo test --workspace --doc --locked || status=1
fi
exit $status

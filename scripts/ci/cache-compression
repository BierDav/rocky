#!/bin/sh
# Keep gzip cache compatibility while compressing in parallel on macOS.
set -eu
[ "$(uname -s)" = Darwin ] || exit 0
command -v zstd >/dev/null 2>&1 && exit 0

if ! command -v gtar >/dev/null 2>&1 || ! command -v pigz >/dev/null 2>&1; then
    if ! command -v brew >/dev/null 2>&1 || [ ! -w "$(brew --prefix)" ]; then
        echo "cache-compression: using system gzip; Homebrew is not writable"
        exit 0
    fi
    if ! HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 brew install gnu-tar pigz; then
        echo "cache-compression: using system gzip; optional compression tools unavailable"
        exit 0
    fi
fi
tools="${RUNNER_TEMP:?RUNNER_TEMP must be set by the CI runner}/cache-compression"
mkdir -p "$tools"
ln -sf "$(command -v pigz)" "$tools/gzip"
printf '%s\n' "$tools" >> "${GITHUB_PATH:?GITHUB_PATH must be set by the CI runner}"

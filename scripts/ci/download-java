#!/usr/bin/env bash
set -euo pipefail

# Resolve only Java 21; setup-java's Temurin resolver paginates every release.
case "$(uname -s)" in
Linux) java_os=linux ;;
Darwin) java_os=mac ;;
*) echo "download-java: unsupported operating system" >&2; exit 1 ;;
esac
case "$(uname -m)" in
x86_64) java_arch=x64 ;;
arm64 | aarch64) java_arch=aarch64 ;;
*) echo "download-java: unsupported architecture" >&2; exit 1 ;;
esac

metadata=$(mktemp "${RUNNER_TEMP:?}/temurin-metadata.XXXXXX")
trap 'rm -f "$metadata"' EXIT
archive="$RUNNER_TEMP/temurin-21-$java_os-$java_arch.tar.gz"
curl --fail --silent --show-error --retry 3 --retry-all-errors --connect-timeout 15 --max-time 60 \
    --output "$metadata" \
    "https://api.adoptium.net/v3/assets/latest/21/hotspot?architecture=$java_arch&image_type=jdk&os=$java_os&vendor=eclipse"
url=$(python3 - "$metadata" <<'PY'
import json, sys
assets = json.load(open(sys.argv[1]))
if len(assets) != 1 or assets[0]["version"]["major"] != 21:
    raise SystemExit("download-java: expected one Java 21 package")
print(assets[0]["binary"]["package"]["link"])
PY
)
curl --fail --silent --show-error --location --retry 3 --retry-all-errors --connect-timeout 15 \
    --max-time 300 --output "$archive" "$url"
python3 - "$metadata" "$archive" "${GITHUB_OUTPUT:?}" <<'PY'
import hashlib, json, sys
asset = json.load(open(sys.argv[1]))[0]
digest = hashlib.sha256()
with open(sys.argv[2], "rb") as archive:
    for block in iter(lambda: archive.read(1024 * 1024), b""):
        digest.update(block)
if digest.hexdigest() != asset["binary"]["package"]["checksum"]:
    raise SystemExit("download-java: package checksum mismatch")
with open(sys.argv[3], "a") as output:
    output.write(f"jdk-file={sys.argv[2]}\nversion={asset['version']['semver']}\n")
PY

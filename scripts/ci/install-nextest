#!/usr/bin/env bash
set -euo pipefail

# Install the cargo-nextest binary for the runner architecture. taiki-e's
# install-action checksum check fails with the Gitea runner's sha256sum.
destination=${1:?usage: install-nextest DESTINATION}
case "$(uname -m)" in
x86_64) target=x86_64-unknown-linux-gnu ;;
aarch64 | arm64) target=aarch64-unknown-linux-gnu ;;
riscv64 | riscv64gc) target=riscv64gc-unknown-linux-gnu ;;
*)
    echo "install-nextest: unsupported Linux architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

mkdir -p "$destination"
version=0.9.148
cached="${CARGO_HOME:-${HOME:?}/.cargo}/registry/.rocky-tools/nextest-$version-$target"
if [[ ! -x "$cached/cargo-nextest" ]]; then
    mkdir -p "$cached"
    archive="$destination/cargo-nextest.tar.gz"
    url="https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-$version/cargo-nextest-$version-$target.tar.gz"
    if curl --fail --silent --show-error --location \
        --retry 3 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 120 \
        --output "$archive" "$url"; then
        tar -xzf "$archive" -C "$cached"
    else
        cargo install cargo-nextest --version "$version" --locked --root "$destination/install"
        cp "$destination/install/bin/cargo-nextest" "$cached/cargo-nextest"
    fi
    rm -f "$archive"
fi
cp "$cached/cargo-nextest" "$destination/cargo-nextest"
"$destination/cargo-nextest" --version
echo "$destination" >> "${GITHUB_PATH:?GITHUB_PATH must be set by the CI runner}"

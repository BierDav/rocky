#!/usr/bin/env bash
set -euo pipefail

# Install the cargo-nextest binary for the runner architecture. taiki-e's
# install-action checksum check fails with the Gitea runner's sha256sum.
destination=${1:?usage: install-nextest DESTINATION}
case "$(uname -m)" in
x86_64) platform=linux ;;
aarch64 | arm64) platform=linux-arm ;;
riscv64 | riscv64gc) platform=linux-riscv64 ;;
*)
    echo "install-nextest: unsupported Linux architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

mkdir -p "$destination"
archive="$destination/cargo-nextest.tar.gz"
curl --fail --silent --show-error --location \
    --retry 3 --retry-all-errors --retry-delay 2 --connect-timeout 10 --max-time 120 \
    --output "$archive" "https://get.nexte.st/latest/$platform"
tar -xzf "$archive" -C "$destination"
rm "$archive"
"$destination/cargo-nextest" --version
echo "$destination" >> "${GITHUB_PATH:?GITHUB_PATH must be set by the CI runner}"

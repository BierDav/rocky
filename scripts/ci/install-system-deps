#!/usr/bin/env bash
set -euo pipefail

# System libraries a bare Debian/Ubuntu runner image lacks before the workspace
# builds. macOS and other hosts ship these with the platform toolchain.
#
#   libclang        rusqlite's bundled-SQLite bindgen build.
#   pkg-config      the gtk-rs, webkit2gtk and OpenSSL -sys build scripts.
#   GTK/WebKitGTK   the Dioxus desktop example (examples/todo-desktop) links
#                   against gtk+-3.0 and webkit2gtk-4.1.
#   libX11, libxdo  the desktop example's `x11` and `libxdo-sys` links.
#   libssl          openssl-sys, through the websocket transport.
packages="libclang-dev libgtk-3-dev libwebkit2gtk-4.1-dev libx11-dev libxdo-dev libssl-dev"

if [ "$(uname -s)" != Linux ]; then
    exit 0
fi

missing=
command -v pkg-config > /dev/null 2>&1 || missing="pkg-config"
for package in $packages; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null \
        | grep -q 'install ok installed' || missing="${missing:+$missing }$package"
done
[ -n "$missing" ] || exit 0

command -v apt-get > /dev/null || {
    echo "install-system-deps: apt-get is unavailable; install: $missing" >&2
    exit 1
}
echo "install-system-deps: installing $missing" >&2
# shellcheck disable=SC2086 # the package names are words
if [ "$(id -u)" -eq 0 ]; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $missing
else
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $missing
fi

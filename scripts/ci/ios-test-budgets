#!/usr/bin/env python3
"""Validate simulator test completion and their integration/e2e tier budgets."""
from pathlib import Path
import re
import subprocess
import sys

E2E = {"rocky.IosResumeTest", "rocky.IosSyncLifecycleTest"}


def results(text):
    expected = re.search(r"\[==========\] Running (\d+) tests", text)
    passed = re.search(r"\[  PASSED  \] (\d+) tests", text)
    measured = re.findall(r"\[       OK \] (.+) \((\d+) ms\)", text)
    if not expected or not passed or int(expected[1]) == 0 or int(expected[1]) != int(passed[1]) or len(measured) != int(expected[1]):
        raise ValueError("iOS tests did not all pass")
    return {name: int(ms) for name, ms in measured}


def check(log, simulator, binary):
    measured = results(log.read_text())
    totals = {"integration": 0, "e2e": 0}
    for name, elapsed in measured.items():
        tier = "e2e" if name.rsplit(".", 1)[0] in E2E else "integration"
        if tier == "integration" and elapsed >= 2000:
            for attempt in range(3):
                rerun = subprocess.run(["xcrun", "simctl", "spawn", simulator, binary,
                                        "--ktest_logger=GTEST", f"--ktest_filter={name}"],
                                       check=True, capture_output=True, text=True, timeout=120)
                evidence = log.with_name(f"{name}-alone-{attempt + 1}.log")
                evidence.write_text(rerun.stdout)
                alone = results(rerun.stdout)
                if set(alone) != {name}:
                    raise ValueError(f"incorrect iOS confirmation selection: {alone}")
                elapsed = min(elapsed, alone[name])
            if elapsed >= 2000:
                raise ValueError(f"iOS integration test exceeds 2 s alone: {name}: {elapsed} ms")
        totals[tier] += elapsed
        print(f"iOS {tier}: {name}: {elapsed} ms")
    if totals["integration"] >= 300_000 or totals["e2e"] >= 900_000:
        raise ValueError(f"iOS tier suite budget exceeded: {totals}")


if __name__ == "__main__":
    check(Path(sys.argv[1]), sys.argv[2], sys.argv[3])

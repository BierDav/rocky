#!/usr/bin/env python3
"""Make Maven-local SDK metadata list only the targets actually published."""
import hashlib
import json
from pathlib import Path
import argparse

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('repository', nargs='?', type=Path, default=Path.home() / '.m2/repository')
parser.add_argument('version', nargs='?', default='0.1.0')
parser.add_argument('--project', type=Path, help='refresh this Kotlin project after Maven-local publication')
args = parser.parse_args()
repository = args.repository
version = args.version
for library in ('rocky-core', 'rocky-sqlite', 'rocky-room'):
    module = repository / 'rocky' / library / version / f'{library}-{version}.module'
    data = json.loads(module.read_text())
    if data['formatVersion'] != '1.1':
        raise ValueError(f'Unsupported Gradle metadata format in {module}')
    variants = []
    removed = 0
    for variant in data['variants']:
        reference = variant.get('available-at')
        if reference and not (module.parent / reference['url']).is_file():
            removed += 1
        else:
            variants.append(variant)
    if removed:
        data['variants'] = variants
        payload = (json.dumps(data, indent=2) + '\n').encode()
        module.write_bytes(payload)
        for algorithm in ('sha1', 'sha256', 'sha512', 'md5'):
            checksum = module.with_name(module.name + '.' + algorithm)
            if checksum.exists():
                checksum.write_text(hashlib.new(algorithm, payload).hexdigest())
        print(f'{library}: omitted {removed} unpublished variants from Maven local')

if args.project:
    for state in (args.project / 'build/incremental.state').glob('*'):
        if not state.is_file() or state.stat().st_size == 0:
            continue
        data = json.loads(state.read_text())
        dependencies = data.get('inputValues', {}).get('dependencies', '')
        if 'mavenLocal' in dependencies:
            state.unlink()
            print(f'local-maven: refreshed dependency resolution in {state.name}')

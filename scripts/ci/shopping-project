#!/usr/bin/env python3
"""Prepare the host's Amper platform matrix over the original application sources."""
from pathlib import Path
import re
import shutil
import sys

app = Path(__file__).resolve().parents[2] / 'examples/shoppinglist-app'
project = Path(sys.argv[1]).resolve()
project.mkdir(parents=True, exist_ok=True)
host = sys.argv[2]
modules = {'linux': ('androidApp', 'desktopApp', 'qualification', 'shared'),
           'ios': ('iosApp', 'shared')}[host]
allowed = {'linux': ('jvm', 'android'), 'ios': ('iosArm64', 'iosSimulatorArm64')}[host]
(project / 'project.yaml').write_text('modules:\n' + ''.join(f'  - {name}\n' for name in modules))


def platforms(match):
    names = [name.strip() for name in match[2].split(',')]
    return match[1] + ', '.join(name for name in names if name in allowed) + ']'


for entry in app.iterdir():
    if entry.name in modules:
        target = project / entry.name
        target.mkdir(exist_ok=True)
        for child in entry.iterdir():
            if child.name in ('build', 'local', '.amper'):
                continue
            destination = target / child.name
            if destination.is_symlink():
                destination.unlink()
            if child.name == 'module.yaml':
                text = re.sub(r'(platforms: \[)([^\]]+)\]', platforms, child.read_text())
                text = re.sub(r'(mobile: \[)([^\]]+)\]', platforms, text)
                destination.write_text(text)
            elif child.is_dir():
                shutil.copytree(child, destination, dirs_exist_ok=True)
            else:
                shutil.copy2(child, destination)
    elif entry.name in ('project.module-template.yaml', 'kotlin', 'kotlin.bat'):
        destination = project / entry.name
        if destination.is_symlink():
            destination.unlink()
        shutil.copy2(entry, destination)
print(project)

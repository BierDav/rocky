#!/bin/sh
# This job owns its checkout; stable paths let Cargo and Gradle reuse outputs.
set -eu
source_path="${HOME:?}/.cache/rocky-ci/${GITHUB_REPOSITORY:?}/ios/source"
mkdir -p "$source_path"
rsync -a --delete --exclude='target/' --exclude='build/' \
    --exclude='.gradle/' --exclude='.kotlin/' --exclude='.amper/' \
    source/ "$source_path/"
rm -rf source
ln -s "$source_path" source
printf 'ROCKY_CI_SOURCE=%s\n' "$source_path" >> "${GITHUB_ENV:?}"

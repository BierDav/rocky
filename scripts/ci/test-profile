#!/bin/sh
# Keys the CI Rust cache to the source tree without changing compiler options.
# Tests build with the profile local checks use (Cargo.toml): optimized
# dependencies, rocky-core and rocky-credentials, unoptimized large workspace
# crates. Appending keeps the repository's .cargo/config.toml (the sccache
# rustc wrapper, the wasm32 runner and [env]).
set -eu
mkdir -p .cargo
[ "$#" -eq 0 ] || printf '\n# CI source tree: %s\n' "$1" >> .cargo/config.toml

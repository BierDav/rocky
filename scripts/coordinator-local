#!/bin/sh
# Starts a three-voter coordination service on loopback for development,
# each voter with its own secrets, and prints the trust bundle clients pin.
# Stop it with: kill $(cat DIR/voter-*.pid)
# See docs/runtime/coordinator-operations.md.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dir=${1:?usage: coordinator-local DIR [BASE_PORT]}
port=${2:-7300}

cargo build --manifest-path "$repo_root/Cargo.toml" -p rocky-coordinator --bin rocky-voter --locked
voter="$repo_root/target/debug/rocky-voter"

if [ ! -f "$dir/admin.json" ]; then
    "$voter" local "$dir" "$port" >/dev/null
    provision=--provision
else
    provision=
fi
for id in 1 2 3; do
    # shellcheck disable=SC2086 # empty when the stores already exist
    "$voter" "$dir/voter-$id.json" $provision >"$dir/voter-$id.log" 2>&1 &
    echo $! >"$dir/voter-$id.pid"
done

if [ -n "$provision" ]; then
    tries=0
    until "$voter" admin "$dir/admin.json" initialize 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -gt 100 ]; then
            echo "voters did not come up; see $dir/voter-*.log" >&2
            exit 1
        fi
        sleep 0.1
    done
fi
echo "bundle: $dir/service/bundle.json"

#!/bin/sh
# Links the repository's Git hooks into .git/hooks; see docs/commits.md.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
hooks="$repo_root/.git/hooks"
[ -d "$repo_root/.git" ] || { echo "install-hooks: $repo_root has no .git directory" >&2; exit 1; }
mkdir -p "$hooks"
for hook in "$repo_root"/scripts/hooks/*; do
    ln -sf "../../scripts/hooks/$(basename -- "$hook")" "$hooks/$(basename -- "$hook")"
    echo "installed $(basename -- "$hook")"
done

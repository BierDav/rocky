#!/bin/sh
# Measures the shapes of write transactions; see docs/features_13/03-intent-shapes.md.
#
#   scripts/intent-shapes             the SDK integration tests that model application flows
#   scripts/intent-shapes --shopping  also the shopping app's qualification scenarios
#
# Each source runs with the test-only `intent-shapes` capture, which appends a
# JSON line per committed SQL transaction to $ROCKY_INTENT_SHAPES/<source>.jsonl
# (default local/intent-shapes). The summary goes to
# docs/features_13/03-intent-shapes-evidence.json; its tables to stdout.
#
# --shopping runs the JVM qualification against the Kotlin SDK in Maven Local at
# $ROCKY_SDK_VERSION (default: the version the app names), loading a native
# library built here with the capture through jna.library.path.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
shopping=false
while [ $# -gt 0 ]; do
    case "$1" in
    --shopping) shopping=true ;;
    *) usage ;;
    esac
    shift
done

captured=${ROCKY_INTENT_SHAPES:-$repo_root/local/intent-shapes}
rm -rf "$captured"
mkdir -p "$captured"
export ROCKY_INTENT_SHAPES="$captured"

# Format, fault-injection and infrastructure tests are left out, as are those on
# the trusted runtime (sql, queries, typed, domains): they commit no secure SQL.
for test in application coordinated group_secrets partitions shared_lists shopping_release; do
    ROCKY_INTENT_SHAPES_SOURCE="sdk-$test" \
        cargo test --locked -p rocky-sdk --features intent-shapes --test "$test"
done

shopping_status=0
if $shopping; then
    cargo build --locked --manifest-path sdks/uniffi/Cargo.toml --lib --features intent-shapes
    project=$(mktemp -d "${TMPDIR:-/tmp}/rocky-intent-shapes-shopping.XXXXXX")
    trap 'rm -rf "$project"' EXIT
    cp -R examples/shoppinglist-app/. "$project"
    if [ -n "${ROCKY_SDK_VERSION:-}" ]; then
        sed -i.orig "s/rocky:rocky-room:[^:]*:/rocky:rocky-room:$ROCKY_SDK_VERSION:/" "$project/shared/module.yaml"
    fi
    ROCKY_INTENT_SHAPES_SOURCE=shopping-qualification \
    ROCKY_SHOPPING_PROJECT="$project" \
    ROCKY_EVIDENCE="$captured/shopping-qualification" \
    JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-} -Djna.library.path=$repo_root/sdks/uniffi/target/debug" \
        examples/shoppinglist-app/qualify || shopping_status=$?
fi

cargo run --locked -q -p rocky-secure --features intent-shapes --example intent_shapes -- \
    "$captured" docs/features_13/03-intent-shapes-evidence.json

# Keep measurements from committed transactions even when a scenario failed.
exit "$shopping_status"

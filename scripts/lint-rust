#!/usr/bin/env python3
"""Rust source policy: no allow attributes and no comments, except short `///`
docs on public items of the published app-facing crates.

  scripts/lint-rust              check every workspace package and every Cargo
                                 workspace of OUTSIDE_THE_WORKSPACE
  scripts/lint-rust PATH...      check the named files
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
OUTSIDE_THE_WORKSPACE = ('benchmarks/engine-comparison',
                         'benchmarks/engine-scale')
UPSTREAM = ('benchmarks/engine-scale/turso-patched/vendor',)
SKIPPED_DIRECTORIES = ('target', 'node_modules')
ALLOW_GUIDANCE = '#[allow(...)] is forbidden; use #[expect(lint, reason = "...")] instead'
COMMENT_GUIDANCE = ('comments, doc comments and #[doc = ...] text are forbidden; carry the meaning '
                    'in a type or guard, a test name or assertion message, or a clearer name, '
                    'or delete it')
DOCUMENTED_CRATES = ('rocky-sdk', 'rocky-tcp', 'rocky-iroh', 'rocky-coordinator')
DOC_GUIDANCE = ('only one- or two-sentence /// docs on pub items, enum variants and fields, and '
                'trait members, and a leading //! in lib.rs, of the published app-facing crates '
                'are allowed, without code blocks')
MAX_DOC_SENTENCES = 2
SENTENCE_END = re.compile(r'[.!?](?=\s|$)')
INLINE_CODE = re.compile(r'`[^`]*`')
TOKEN = re.compile(
    r'//[^\n]*|/\*|(?P<raw>(?:br|cr|r)(?P<hashes>\#*)")'
    r'|(?:b|c)?"(?:\\.|[^"\\])*"'
    r"|b?'(?:\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'"
    r'|(?P<word>(?:r\#)?[a-zA-Z_]\w*)|[^\s]',
    re.DOTALL,
)


def lexemes(source):
    """Yield `(kind, value, position)` for comments and tokens, skipping literals."""
    offset = 0
    while match := TOKEN.search(source, offset):
        value = match.group()
        offset = match.end()
        if value.startswith('//'):
            yield 'comment', value, match.start()
            continue
        if value == '/*':
            depth = 1
            while depth and (part := re.search(r'/\*|\*/', source[offset:])):
                depth += 1 if part.group() == '/*' else -1
                offset += part.end()
            yield 'comment', source[match.start():offset], match.start()
            if depth:
                return
            continue
        if match.group('raw'):
            end = source.find('"' + match.group('hashes'), offset)
            offset = len(source) if end < 0 else end + 1 + len(match.group('hashes'))
            continue
        if not match.group('word') and ('"' in value or "'" in value and len(value) > 1):
            continue
        yield 'token', value.removeprefix('r#'), match.start()


def tokens(source):
    """Keep token positions, ignoring Rust comments and literals."""
    for kind, value, position in lexemes(source):
        if kind == 'token':
            yield value, position


def arguments(parts):
    start = depth = 0
    for index, (value, _) in enumerate(parts):
        if value in ('(', '[', '{'):
            depth += 1
        elif value in (')', ']', '}'):
            depth -= 1
        elif value == ',' and depth == 0:
            yield parts[start:index]
            start = index + 1
    yield parts[start:]


def allowed(attribute):
    if len(attribute) < 2 or attribute[1][0] != '(':
        return
    if attribute[0][0] == 'allow':
        yield attribute[0][1]
    elif attribute[0][0] == 'cfg_attr':
        for child in list(arguments(attribute[2:-1]))[1:]:
            yield from allowed(child)


def documented(attribute):
    if len(attribute) < 2:
        return
    if attribute[0][0] == 'doc' and attribute[1][0] == '=':
        yield attribute[0][1]
    elif attribute[0][0] == 'cfg_attr' and attribute[1][0] == '(':
        for child in list(arguments(attribute[2:-1]))[1:]:
            yield from documented(child)


def attributes(source):
    """Token lists inside each outer or inner attribute."""
    parts = list(tokens(source))
    for index, (value, _) in enumerate(parts):
        if value != '#':
            continue
        start = index + 1
        if start < len(parts) and parts[start][0] == '!':
            start += 1
        if start >= len(parts) or parts[start][0] != '[':
            continue
        depth = 1
        for end in range(start + 1, len(parts)):
            if parts[end][0] == '[':
                depth += 1
            elif parts[end][0] == ']':
                depth -= 1
            if depth == 0:
                yield parts[start + 1:end]
                break


def line(source, position):
    return source.count('\n', 0, position) + 1


def violations(source):
    """Lines of allow attributes, including inner and inactive conditional ones."""
    for attribute in attributes(source):
        for position in allowed(attribute):
            yield line(source, position)


def comments(source, documented_crate=False, crate_root=False):
    """Every line a comment spans and each `doc = ...` attribute, except, in a
    documented crate, short `///` docs on public items and a short leading `//!`
    in the crate root."""
    lines = set()
    for kind, value, position in lexemes(source):
        if kind == 'comment':
            first = line(source, position)
            lines.update(range(first, first + value.count('\n') + 1))
    for attribute in attributes(source):
        lines.update(line(source, position) for position in documented(attribute))
    if documented_crate:
        lines.difference_update(public_docs(source))
    if documented_crate and crate_root:
        lines.difference_update(crate_doc(source))
    return sorted(lines)


def crate_doc(source):
    """Lines of the `//!` block before the first token, when it is short."""
    block = []
    for kind, value, position in lexemes(source):
        if kind != 'comment' or not value.startswith('//!'):
            break
        block.append((value, position))
    return {line(source, position) for _, position in block} if block and short(block) else set()


def outer_doc(value):
    return value.startswith('///') and not value.startswith('////')


def doc_blocks(source):
    """Runs of `///` lines with only whitespace between them, each with the index
    of the first token after it."""
    block, count = [], 0
    for kind, value, position in lexemes(source):
        if kind == 'comment' and outer_doc(value):
            block.append((value, position))
            continue
        if block and kind == 'token':
            yield block, count
        block = []
        count += kind == 'token'


def skip_attributes(parts, index):
    """The index of the item after the attributes at `index`, and whether one of
    them exports a macro."""
    exported = False
    while index + 1 < len(parts) and parts[index][0] == '#' and parts[index + 1][0] == '[':
        exported |= index + 2 < len(parts) and parts[index + 2][0] == 'macro_export'
        depth = 0
        for index in range(index + 1, len(parts)):
            depth += {'[': 1, ']': -1}.get(parts[index][0], 0)
            if depth == 0:
                break
        index += 1
    return index, exported


def public(parts, index):
    return (index < len(parts) and parts[index][0] == 'pub'
            and (index + 1 >= len(parts) or parts[index + 1][0] != '('))


def member_bodies(parts):
    """Token indices inside the body of a `pub enum` (at any depth) or directly
    inside a `pub trait`, where members carry no `pub` of their own."""
    inside = set()
    stack, pending, opened_by_pub = [], None, False
    for index, (value, _) in enumerate(parts):
        if value == 'pub':
            opened_by_pub = public(parts, index)
        elif value in ('enum', 'trait') and opened_by_pub:
            pending = value
        elif value == ';':
            pending, opened_by_pub = None, False
        elif value == '{':
            enclosing = stack[-1] if stack else None
            stack.append(pending or ('enum' if enclosing == 'enum' else None))
            pending, opened_by_pub = None, False
            continue
        elif value == '}':
            if stack:
                stack.pop()
            pending, opened_by_pub = None, False
            continue
        if stack and stack[-1] in ('enum', 'trait'):
            inside.add(index)
    return inside


def short(block):
    text = ' '.join(value[3:].strip() for value, _ in block)
    return '```' not in text and len(SENTENCE_END.findall(INLINE_CODE.sub('', text))) <= MAX_DOC_SENTENCES


def public_docs(source):
    """Lines of `///` blocks that document a public item, exported macro, enum
    variant or field, or trait member in at most two sentences without a code block."""
    parts = list(tokens(source))
    members = member_bodies(parts)
    lines = set()
    for block, following in doc_blocks(source):
        if not short(block):
            continue
        item, exported = skip_attributes(parts, following)
        if public(parts, item) or item in members or exported:
            lines.update(line(source, position) for _, position in block)
    return lines


def documented_source(path):
    """`(documented crate, crate root)` for a source file."""
    try:
        parts = path.resolve().relative_to(ROOT).parts
    except ValueError:
        return False, False
    documented = (len(parts) > 3 and parts[0] == 'crates' and parts[1] in DOCUMENTED_CRATES
                  and parts[2] == 'src')
    return documented, documented and parts[3:] == ('lib.rs',)


def rust_sources(directory, nested_packages):
    """Rust files under `directory`, without build output, the repository's `local`
    directory or upstream code; nested packages only when `nested_packages`."""
    excluded = {ROOT / 'local', *(ROOT / path for path in UPSTREAM)}
    for current, dirs, files in os.walk(directory):
        current = Path(current)
        dirs[:] = sorted(
            name for name in dirs
            if name not in SKIPPED_DIRECTORIES and not name.startswith('.')
            and current / name not in excluded
            and (nested_packages or not (current / name / 'Cargo.toml').exists()))
        for name in sorted(files):
            if name.endswith('.rs'):
                yield current / name


def workspace_packages():
    """The directory of each member of the root Cargo workspace."""
    metadata = json.loads(subprocess.check_output(
        ['cargo', 'metadata', '--offline', '--locked', '--no-deps', '--format-version', '1'], cwd=ROOT))
    members = set(metadata['workspace_members'])
    for package in sorted(metadata['packages'], key=lambda package: package['name']):
        if package['id'] in members:
            yield Path(package['manifest_path']).parent.resolve()


def scanned():
    """The sources of each workspace package, then of each Cargo workspace outside it."""
    for directory in workspace_packages():
        yield rust_sources(directory, nested_packages=False)
    for path in OUTSIDE_THE_WORKSPACE:
        if (ROOT / path).is_dir():
            yield rust_sources(ROOT / path, nested_packages=True)


def report(path, lines, guidance):
    for line in lines:
        print(f'{path}:{line}: error: {guidance}', file=sys.stderr)
    return bool(lines)


def check(path):
    source = path.read_text()
    documented_crate, crate_root = documented_source(path)
    failed = report(path, list(violations(source)), ALLOW_GUIDANCE)
    return failed | report(path, list(comments(source, documented_crate, crate_root)),
                           DOC_GUIDANCE if documented_crate else COMMENT_GUIDANCE)


def check_paths(paths):
    failed = False
    for path in sorted(paths):
        failed |= check(path)
    return failed


def check_workspace():
    failed = False
    for sources in scanned():
        for path in sources:
            failed |= check(path)
    return failed


def main(arguments):
    if options := [argument for argument in arguments if argument.startswith('-')]:
        print(f'lint-rust: unknown option {options[0]}', file=sys.stderr)
        print(__doc__, end='', file=sys.stderr)
        return 2
    if arguments:
        return int(check_paths(map(Path, arguments)))
    return int(check_workspace())


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

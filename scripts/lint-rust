#!/usr/bin/env python3
"""Rust source policy: no allow attributes and no comments except docs.

  scripts/lint-rust              check every workspace package; a package listed
                                 in scripts/comment-budgets.toml may hold exactly
                                 its budget of plain comments
  scripts/lint-rust PATH...      check the named files, reporting every comment
  scripts/lint-rust --fix        lower budgets to the current counts, then check
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib


ROOT = Path(__file__).resolve().parent.parent
BUDGETS = ROOT / 'scripts/comment-budgets.toml'
ALLOW_GUIDANCE = '#[allow(...)] is forbidden; use #[expect(lint, reason = "...")] instead'
COMMENT_GUIDANCE = ('plain comments are forbidden; express the reason as a type, a named item '
                    'with a doc comment, a test or an assertion message, or delete it')
TOKEN = re.compile(
    r'//[^\n]*|/\*|(?P<raw>(?:br|cr|r)(?P<hashes>\#*)")'
    r'|(?:b|c)?"(?:\\.|[^"\\])*"'
    r"|b?'(?:\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'"
    r'|(?P<word>(?:r\#)?[a-zA-Z_]\w*)|[^\s]',
    re.DOTALL,
)


def lexemes(source):
    """Yield `(kind, value, position)` for comments and tokens, skipping literals."""
    offset = 0
    while match := TOKEN.search(source, offset):
        value = match.group()
        offset = match.end()
        if value.startswith('//'):
            yield 'comment', value, match.start()
            continue
        if value == '/*':
            depth = 1
            while depth and (part := re.search(r'/\*|\*/', source[offset:])):
                depth += 1 if part.group() == '/*' else -1
                offset += part.end()
            yield 'comment', source[match.start():offset], match.start()
            if depth:
                return
            continue
        if match.group('raw'):
            end = source.find('"' + match.group('hashes'), offset)
            offset = len(source) if end < 0 else end + 1 + len(match.group('hashes'))
            continue
        if not match.group('word') and ('"' in value or "'" in value and len(value) > 1):
            continue
        yield 'token', value.removeprefix('r#'), match.start()


def tokens(source):
    """Keep token positions, ignoring Rust comments and literals."""
    for kind, value, position in lexemes(source):
        if kind == 'token':
            yield value, position


def is_doc(comment):
    if comment.startswith('//'):
        return comment.startswith('//!') or comment.startswith('///') and not comment.startswith('////')
    return comment.startswith('/*!') or (
        comment.startswith('/**') and not comment.startswith('/***') and comment != '/**/')


def comments(source):
    """Lines of comments that are not documentation."""
    for kind, value, position in lexemes(source):
        if kind == 'comment' and not is_doc(value):
            yield source.count('\n', 0, position) + 1


def arguments(parts):
    start = depth = 0
    for index, (value, _) in enumerate(parts):
        if value in ('(', '[', '{'):
            depth += 1
        elif value in (')', ']', '}'):
            depth -= 1
        elif value == ',' and depth == 0:
            yield parts[start:index]
            start = index + 1
    yield parts[start:]


def forbidden(attribute):
    if len(attribute) < 2 or attribute[1][0] != '(':
        return
    if attribute[0][0] == 'allow':
        yield attribute[0][1]
    elif attribute[0][0] == 'cfg_attr':
        for child in list(arguments(attribute[2:-1]))[1:]:
            yield from forbidden(child)


def violations(source):
    """Lines of allow attributes, including inner and inactive conditional ones."""
    parts = list(tokens(source))
    for index, (value, _) in enumerate(parts):
        if value != '#':
            continue
        start = index + 1
        if start < len(parts) and parts[start][0] == '!':
            start += 1
        if start >= len(parts) or parts[start][0] != '[':
            continue
        depth = 1
        for end in range(start + 1, len(parts)):
            if parts[end][0] == '[':
                depth += 1
            elif parts[end][0] == ']':
                depth -= 1
            if depth == 0:
                for position in forbidden(parts[start + 1:end]):
                    yield source.count('\n', 0, position) + 1
                break


def package_sources(directory):
    """Rust files of the package at `directory`, excluding nested packages."""
    for current, dirs, files in os.walk(directory):
        dirs[:] = sorted(d for d in dirs if d not in ('target', 'local', 'node_modules')
                         and not d.startswith('.') and not (Path(current) / d / 'Cargo.toml').exists())
        for name in sorted(files):
            if name.endswith('.rs'):
                yield Path(current) / name


def workspace_packages():
    """`(name, directory, upstream)` per member; vendored upstream code keeps its comments."""
    metadata = json.loads(subprocess.check_output(
        ['cargo', 'metadata', '--offline', '--locked', '--no-deps', '--format-version', '1'], cwd=ROOT))
    members = set(metadata['workspace_members'])
    for package in sorted(metadata['packages'], key=lambda package: package['name']):
        if package['id'] in members:
            directory = Path(package['manifest_path']).parent.resolve()
            yield package['name'], directory, directory.is_relative_to(ROOT / 'vendor')


def read_budgets():
    return tomllib.loads(BUDGETS.read_text()) if BUDGETS.exists() else {}


def write_budgets(budgets):
    header = ''.join(line for line in BUDGETS.read_text().splitlines(keepends=True)
                     if line.startswith('#'))
    BUDGETS.write_text(header + '\n' + ''.join(f'{name} = {count}\n'
                                               for name, count in sorted(budgets.items())))


def report(path, lines, guidance):
    for line in lines:
        print(f'{path}:{line}: error: {guidance}', file=sys.stderr)
    return bool(lines)


def check_paths(paths):
    failed = False
    for path in sorted(paths):
        source = path.read_text()
        failed |= report(path, list(violations(source)), ALLOW_GUIDANCE)
        failed |= report(path, list(comments(source)), COMMENT_GUIDANCE)
    return failed


def check_workspace(fix):
    failed = False
    counts = {}
    for name, directory, upstream in workspace_packages():
        found = []
        for path in package_sources(directory):
            source = path.read_text()
            failed |= report(path, list(violations(source)), ALLOW_GUIDANCE)
            if not upstream:
                found.extend((path, line) for line in comments(source))
        counts[name] = found
    budgets = read_budgets()
    if fix:
        lowered = {name: min(budget, len(counts.get(name, [])))
                   for name, budget in budgets.items()}
        budgets = {name: budget for name, budget in lowered.items() if budget}
        write_budgets(budgets)
    for name, budget in budgets.items():
        if name not in counts:
            print(f'{BUDGETS}: error: {name} is not a workspace package', file=sys.stderr)
            failed = True
    for name, found in counts.items():
        budget = budgets.get(name)
        if budget is None:
            for path, line in found:
                failed |= report(path, [line], COMMENT_GUIDANCE)
        elif len(found) > budget:
            print(f'{name}: error: {len(found)} plain comments exceed its budget of {budget} in '
                  f'{BUDGETS.name}; list a file\'s comments with scripts/lint-rust PATH',
                  file=sys.stderr)
            failed = True
        elif len(found) < budget:
            print(f'{name}: error: {len(found)} plain comments remain under its budget of {budget}; '
                  'lower it with scripts/lint --fix', file=sys.stderr)
            failed = True
    return failed


def main(arguments):
    fix = arguments[:1] == ['--fix']
    if fix:
        arguments = arguments[1:]
    if arguments and not fix:
        return int(check_paths(map(Path, arguments)))
    if arguments:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return int(check_workspace(fix))


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""Rust source policy: no allow attributes, no comments and no doc text.

  scripts/lint-rust              check every workspace package and every Cargo
                                 workspace of OUTSIDE_THE_WORKSPACE; a workspace
                                 package listed in scripts/comment-budgets.toml
                                 may hold exactly its budget of comment lines
  scripts/lint-rust PATH...      check the named files, reporting every comment
  scripts/lint-rust --fix        lower budgets to the current counts, then check;
                                 the budget file goes once every budget is zero
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib


ROOT = Path(__file__).resolve().parent.parent
BUDGETS = ROOT / 'scripts/comment-budgets.toml'
OUTSIDE_THE_WORKSPACE = ('benchmarks/chaos', 'benchmarks/engine-comparison',
                         'benchmarks/engine-scale')
UPSTREAM = ('benchmarks/engine-scale/turso-patched/vendor',)
SKIPPED_DIRECTORIES = ('target', 'node_modules')
ALLOW_GUIDANCE = '#[allow(...)] is forbidden; use #[expect(lint, reason = "...")] instead'
COMMENT_GUIDANCE = ('comments, doc comments and #[doc = ...] text are forbidden; carry the meaning '
                    'in a type or guard, a test name or assertion message, or a clearer name, '
                    'or delete it')
TOKEN = re.compile(
    r'//[^\n]*|/\*|(?P<raw>(?:br|cr|r)(?P<hashes>\#*)")'
    r'|(?:b|c)?"(?:\\.|[^"\\])*"'
    r"|b?'(?:\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'"
    r'|(?P<word>(?:r\#)?[a-zA-Z_]\w*)|[^\s]',
    re.DOTALL,
)


def lexemes(source):
    """Yield `(kind, value, position)` for comments and tokens, skipping literals."""
    offset = 0
    while match := TOKEN.search(source, offset):
        value = match.group()
        offset = match.end()
        if value.startswith('//'):
            yield 'comment', value, match.start()
            continue
        if value == '/*':
            depth = 1
            while depth and (part := re.search(r'/\*|\*/', source[offset:])):
                depth += 1 if part.group() == '/*' else -1
                offset += part.end()
            yield 'comment', source[match.start():offset], match.start()
            if depth:
                return
            continue
        if match.group('raw'):
            end = source.find('"' + match.group('hashes'), offset)
            offset = len(source) if end < 0 else end + 1 + len(match.group('hashes'))
            continue
        if not match.group('word') and ('"' in value or "'" in value and len(value) > 1):
            continue
        yield 'token', value.removeprefix('r#'), match.start()


def tokens(source):
    """Keep token positions, ignoring Rust comments and literals."""
    for kind, value, position in lexemes(source):
        if kind == 'token':
            yield value, position


def arguments(parts):
    start = depth = 0
    for index, (value, _) in enumerate(parts):
        if value in ('(', '[', '{'):
            depth += 1
        elif value in (')', ']', '}'):
            depth -= 1
        elif value == ',' and depth == 0:
            yield parts[start:index]
            start = index + 1
    yield parts[start:]


def allowed(attribute):
    if len(attribute) < 2 or attribute[1][0] != '(':
        return
    if attribute[0][0] == 'allow':
        yield attribute[0][1]
    elif attribute[0][0] == 'cfg_attr':
        for child in list(arguments(attribute[2:-1]))[1:]:
            yield from allowed(child)


def documented(attribute):
    if len(attribute) < 2:
        return
    if attribute[0][0] == 'doc' and attribute[1][0] == '=':
        yield attribute[0][1]
    elif attribute[0][0] == 'cfg_attr' and attribute[1][0] == '(':
        for child in list(arguments(attribute[2:-1]))[1:]:
            yield from documented(child)


def attributes(source):
    """Token lists inside each outer or inner attribute."""
    parts = list(tokens(source))
    for index, (value, _) in enumerate(parts):
        if value != '#':
            continue
        start = index + 1
        if start < len(parts) and parts[start][0] == '!':
            start += 1
        if start >= len(parts) or parts[start][0] != '[':
            continue
        depth = 1
        for end in range(start + 1, len(parts)):
            if parts[end][0] == '[':
                depth += 1
            elif parts[end][0] == ']':
                depth -= 1
            if depth == 0:
                yield parts[start + 1:end]
                break


def line(source, position):
    return source.count('\n', 0, position) + 1


def violations(source):
    """Lines of allow attributes, including inner and inactive conditional ones."""
    for attribute in attributes(source):
        for position in allowed(attribute):
            yield line(source, position)


def comments(source):
    """Every line a comment spans, doc comments included, and each `doc = ...` attribute."""
    lines = set()
    for kind, value, position in lexemes(source):
        if kind == 'comment':
            first = line(source, position)
            lines.update(range(first, first + value.count('\n') + 1))
    for attribute in attributes(source):
        lines.update(line(source, position) for position in documented(attribute))
    return sorted(lines)


def rust_sources(directory, nested_packages):
    """Rust files under `directory`, without build output, the repository's `local`
    directory or upstream code; nested packages only when `nested_packages`."""
    excluded = {ROOT / 'local', *(ROOT / path for path in UPSTREAM)}
    for current, dirs, files in os.walk(directory):
        current = Path(current)
        dirs[:] = sorted(
            name for name in dirs
            if name not in SKIPPED_DIRECTORIES and not name.startswith('.')
            and current / name not in excluded
            and (nested_packages or not (current / name / 'Cargo.toml').exists()))
        for name in sorted(files):
            if name.endswith('.rs'):
                yield current / name


def workspace_packages():
    """`(name, directory)` per member of the root Cargo workspace."""
    metadata = json.loads(subprocess.check_output(
        ['cargo', 'metadata', '--offline', '--locked', '--no-deps', '--format-version', '1'], cwd=ROOT))
    members = set(metadata['workspace_members'])
    for package in sorted(metadata['packages'], key=lambda package: package['name']):
        if package['id'] in members:
            yield package['name'], Path(package['manifest_path']).parent.resolve()


def scanned(packages):
    """`(name, sources)` per workspace package, then per Cargo workspace outside it."""
    for name, directory in packages.items():
        yield name, rust_sources(directory, nested_packages=False)
    for path in OUTSIDE_THE_WORKSPACE:
        if (ROOT / path).is_dir():
            yield path, rust_sources(ROOT / path, nested_packages=True)


def report(path, lines, guidance):
    for line in lines:
        print(f'{path}:{line}: error: {guidance}', file=sys.stderr)
    return bool(lines)


def check_paths(paths):
    failed = False
    for path in sorted(paths):
        source = path.read_text()
        failed |= report(path, list(violations(source)), ALLOW_GUIDANCE)
        failed |= report(path, list(comments(source)), COMMENT_GUIDANCE)
    return failed


def check_workspace(fix):
    failed = False
    counts = {}
    packages = dict(workspace_packages())
    for name, sources in scanned(packages):
        found = []
        for path in sources:
            source = path.read_text()
            failed |= report(path, list(violations(source)), ALLOW_GUIDANCE)
            found.extend((path, number) for number in comments(source))
        counts[name] = found
    budgets, over = check_budgets(counts, packages, fix)
    failed |= over
    for name, found in counts.items():
        if name not in budgets:
            for path, number in found:
                failed |= report(path, [number], COMMENT_GUIDANCE)
    return failed


def check_budgets(counts, packages, fix):
    """Budgets of packages still converting; delete with the budget file once it is gone."""
    budgets = tomllib.loads(BUDGETS.read_text()) if BUDGETS.exists() else {}
    if fix and budgets:
        budgets = {name: min(budget, len(counts.get(name, [])))
                   for name, budget in budgets.items()}
        budgets = {name: budget for name, budget in budgets.items() if budget}
        if budgets:
            header = ''.join(line for line in BUDGETS.read_text().splitlines(keepends=True)
                             if line.startswith('#'))
            BUDGETS.write_text(header + '\n' + ''.join(f'{name} = {count}\n'
                                                       for name, count in sorted(budgets.items())))
        else:
            BUDGETS.unlink()
            print(f'{BUDGETS.name}: every budget is zero; the file is gone', file=sys.stderr)
    failed = False
    for name, budget in budgets.items():
        found = len(counts.get(name, []))
        if name not in packages:
            print(f'{BUDGETS}: error: {name} is not a workspace package', file=sys.stderr)
            failed = True
        elif found > budget:
            print(f'{name}: error: {found} comment lines exceed its budget of {budget} in '
                  f'{BUDGETS.name}; list a file\'s comments with scripts/lint-rust PATH',
                  file=sys.stderr)
            failed = True
        elif found < budget:
            print(f'{name}: error: {found} comment lines remain under its budget of {budget}; '
                  'lower it with scripts/lint --fix', file=sys.stderr)
            failed = True
    return budgets, failed


def main(arguments):
    fix = arguments[:1] == ['--fix']
    if fix:
        arguments = arguments[1:]
    if arguments and not fix:
        return int(check_paths(map(Path, arguments)))
    if arguments:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return int(check_workspace(fix))


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

# shellcheck shell=sh disable=SC2034 # scripts/lint reads the module's variables
# GitHub workflows, including their embedded scripts.
tools='actionlint shellcheck python3'

# Explicit paths: CI checks out an archive without .git, where bare actionlint
# finds no project.
check() {
    set --
    for workflow in .github/workflows/*.yml .github/workflows/*.yaml; do
        [ ! -e "$workflow" ] || set -- "$@" "$workflow"
    done
    actionlint "$@"
    scripts/test-test-tiers
}

#!/usr/bin/env python3
"""Prepare once, then pair member pulls using existing migrations test binaries.

Build only after other measurements finish. Both binaries need the same test
harness; baseline production code must remain at phase-start 4e4e2497.
"""

import argparse
import datetime
import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OVERRIDES = ("ROCKY_CHECKPOINT_STORE_ROWS", "ROCKY_RECEIVE_REQUESTS", "ROCKY_CHECKPOINT_STORE_METADATA", "ROCKY_PULL_FIXTURE")


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def fixture_digest(path):
    files = [path / "fixture.json"]
    for role in ("a", "b"):
        files.extend(sorted((path / role).rglob("*")))
    result = hashlib.sha256()
    for file in files:
        if file.is_symlink():
            raise RuntimeError(f"fixture contains a symbolic link: {file}")
        if file.is_file():
            result.update(str(file.relative_to(path)).encode())
            result.update(b"\0")
            result.update(bytes.fromhex(digest(file)))
    return result.hexdigest()


def power():
    if platform.system() == "Darwin":
        return subprocess.check_output(["pmset", "-g", "batt"], text=True).strip()
    return None


def run(binary, test, fixture, log, overrides=None):
    environment = {key: value for key, value in os.environ.items() if key not in OVERRIDES}
    environment["ROCKY_PULL_FIXTURE"] = str(fixture)
    environment.update(overrides or {})
    command = [str(binary), "--exact", f"prepared_pull::{test}", "--ignored", "--nocapture", "--test-threads=1"]
    # libtest succeeds when a misspelled filter runs zero tests. Refuse that early.
    listed = subprocess.check_output([*command, "--list"], cwd=ROOT, env=environment, text=True)
    if f"prepared_pull::{test}: test" not in listed:
        raise RuntimeError(f"{binary} lacks the prepared-pull harness")
    metadata = {"started": datetime.datetime.now(datetime.UTC).isoformat(),
                "load_at_start": os.getloadavg(), "power_at_start": power(), "log": str(log)}
    print(f"{log.stem}: started {metadata['started']}", flush=True)
    with log.open("w") as stream:
        result = subprocess.run(command, cwd=ROOT, env=environment, stdout=stream,
                                stderr=subprocess.STDOUT, check=False)
    if result.returncode:
        raise RuntimeError(f"{test} failed with exit {result.returncode}; see {log}")
    metadata["power_at_end"] = power()
    if test == "replay":
        match = re.search(r"STAGE rows=100000 member_pull=([\d.]+)(s|ms|µs|ns)", log.read_text())
        if match is None:
            raise RuntimeError(f"missing 100k member-pull timing: {log}")
        metadata["seconds"] = float(match[1]) * {"s": 1, "ms": 1e-3, "µs": 1e-6, "ns": 1e-9}[match[2]]
        print(f"{log.stem}: member pull {metadata['seconds']:.6f}s", flush=True)
    return metadata


def prepare(args):
    destination = args.fixture.resolve()
    if destination.exists():
        raise RuntimeError(f"refusing to replace prepared fixture: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    # Publish only after the preparation process and every assertion succeed.
    with tempfile.TemporaryDirectory(prefix=".preparing-pull-", dir=destination.parent) as staging:
        staging = Path(staging)
        binary = staging / "prepare-tests"
        shutil.copy2(args.binary.resolve(), binary)
        fixture = staging / "fixture"
        try:
            metadata = run(binary, "prepare", fixture, staging / "prepare.log")
        except Exception:
            log = staging / "prepare.log"
            if log.exists():
                with tempfile.NamedTemporaryFile(prefix=f"{destination.name}-failed-", suffix=".log",
                                                 dir=destination.parent, delete=False) as saved:
                    saved.write(log.read_bytes())
                    print(f"Preparation failure log: {saved.name}", flush=True)
            raise
        metadata.update({"host": platform.platform(), "binary_sha256": digest(binary),
                         "fixture_sha256": fixture_digest(fixture)})
        shutil.move(staging / "prepare.log", fixture / "prepare.log")
        metadata["log"] = str(destination / "prepare.log")
        (fixture / "provenance.json").write_text(json.dumps(metadata, indent=2) + "\n")
        fixture.rename(destination)
    print(f"Prepared fixture: {destination}", flush=True)


def measure(args):
    fixture = args.fixture.resolve()
    provenance = json.loads((fixture / "provenance.json").read_text())
    expected = provenance["fixture_sha256"]
    if fixture_digest(fixture) != expected:
        raise RuntimeError("prepared fixture changed since preparation")
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=False)
    binaries = {}
    bounds = [None] if args.defaults else sorted(set(args.rows))
    report = {"host": platform.platform(), "fixture": str(fixture), "preparation": provenance,
              "defaults": args.defaults,
              "receive_requests": None if args.defaults else args.receive_requests,
              "metadata_records": None if args.defaults else args.metadata_records, "pairs": []}
    for label, source in (("baseline", args.baseline_binary), ("candidate", args.candidate_binary)):
        binary = output / f"{label}-tests"
        shutil.copy2(source.resolve(), binary)
        binaries[label] = binary
        report[f"{label}_binary_sha256"] = digest(binary)
    for rows in bounds:
        for sample in range(1, args.samples + 1):
            pair = {"rows": rows, "sample": sample}
            # Alternate ordering to reduce systematic drift across repeated samples.
            order = ("baseline", "candidate") if sample % 2 else ("candidate", "baseline")
            pair["order"] = order
            for label in order:
                overrides = {} if label == "baseline" or args.defaults else {
                    "ROCKY_CHECKPOINT_STORE_ROWS": str(rows),
                    "ROCKY_RECEIVE_REQUESTS": str(args.receive_requests),
                    "ROCKY_CHECKPOINT_STORE_METADATA": str(args.metadata_records),
                }
                pair[label] = run(binaries[label], "replay", fixture,
                                  output / f"rows-{rows}-sample-{sample}-{label}.log", overrides)
            sources = {run[key].splitlines()[0] for run in (pair["baseline"], pair["candidate"])
                       for key in ("power_at_start", "power_at_end") if run[key] is not None}
            pair["power_consistent"] = len(sources) <= 1
            pair["ratio"] = pair["candidate"]["seconds"] / pair["baseline"]["seconds"]
            report["pairs"].append(pair)
            (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    if fixture_digest(fixture) != expected:
        raise RuntimeError("measurement modified the prepared fixture")
    passing = [rows for rows in bounds if
               all(pair["power_consistent"] for pair in report["pairs"] if pair["rows"] == rows)
               and sum(pair["candidate"]["seconds"] for pair in report["pairs"] if pair["rows"] == rows)
               <= 1.10 * sum(pair["baseline"]["seconds"] for pair in report["pairs"] if pair["rows"] == rows)]
    report["selected_rows"] = min(passing) if passing and not args.defaults else None
    if args.defaults:
        report["default_bound_passed"] = bool(passing)
    (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    if args.defaults:
        print(f"Default bounds pass 110% gate: {bool(passing)}", flush=True)
    else:
        print(f"Smallest passing step: {report['selected_rows']}", flush=True)
    return 0 if passing else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    preparation = commands.add_parser("prepare", help="publish a closed 100k fixture once")
    preparation.add_argument("--binary", type=Path, required=True)
    preparation.add_argument("--fixture", type=Path, required=True)
    measurement = commands.add_parser("measure", help="pair fresh copies; never runs Cargo")
    measurement.add_argument("--baseline-binary", type=Path, required=True)
    measurement.add_argument("--candidate-binary", type=Path, required=True)
    measurement.add_argument("--fixture", type=Path, required=True)
    measurement.add_argument("--output", type=Path, required=True)
    selection = measurement.add_mutually_exclusive_group()
    selection.add_argument("--rows", nargs="+", type=int)
    selection.add_argument("--defaults", action="store_true", help="confirm compiled defaults with no tuning overrides")
    measurement.add_argument("--metadata-records", type=int, choices=[1, 2, 4, 8, 16], default=1)
    measurement.add_argument("--receive-requests", type=int, choices=[2, 4], default=4)
    measurement.add_argument("--samples", type=int, default=1)
    args = parser.parse_args()
    if args.command == "prepare":
        prepare(args)
        return 0
    args.rows = args.rows or [32, 64, 128]
    if args.samples < 1 or any(rows < 1 or rows > 256 for rows in args.rows):
        parser.error("samples must be positive and rows must be between 1 and 256")
    return measure(args)


if __name__ == "__main__":
    raise SystemExit(main())

#!/bin/sh
# Prints `true` when shipped code differs between a release tag and a commit,
# otherwise `false`; see docs/releasing.md. Needs a clone with both revisions.
#
#   scripts/release/code-changed TAG SHA
set -eu

base=${1:?usage: code-changed TAG SHA}
head=${2:?usage: code-changed TAG SHA}
# Paths that end up in a published artifact. Markdown never does.
shipped='^(crates/|sdks/|Cargo\.toml$|Cargo\.lock$|rust-toolchain\.toml$|\.dockerignore$)'

files=$(git diff --name-only "$base...$head")
if printf '%s\n' "$files" | grep -E "$shipped" | grep -vqE '\.md$'; then
    echo true
else
    echo false
fi

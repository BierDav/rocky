#!/bin/sh
# Writes rocky:rocky-core-jvm:VERSION into a Maven repository directory, merging
# the native libraries of per-platform packaged jars; see docs/releasing.md.
#
#   scripts/release/jvm-maven VERSION OUTPUT JAR...
set -eu

version=${1:?usage: jvm-maven VERSION OUTPUT JAR...}
output=${2:?usage: jvm-maven VERSION OUTPUT JAR...}
shift 2
[ "$#" -gt 0 ] || { echo "jvm-maven: no jars" >&2; exit 2; }

directory="$output/rocky/rocky-core-jvm/$version"
mkdir -p "$directory"
jar="$(cd "$directory" && pwd)/rocky-core-jvm-$version.jar"
cp "$1" "$jar"
shift
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# Every packaged jar carries the same classes and its host's JNA resource directory.
for other in "$@"; do
    natives=$(unzip -Z1 "$other" | grep -E '^(darwin|linux|win32|freebsd)-[^/]+/[^/]+$' || true)
    [ -n "$natives" ] || { echo "jvm-maven: $other has no native library" >&2; exit 1; }
    # shellcheck disable=SC2086
    unzip -q -o "$other" $natives -d "$work"
    (cd "$work" && zip -q -r "$jar" .)
    rm -rf "${work:?}"/*
done

# Mirrors the dependencies of sdks/kotlin/rocky-core/module.yaml for the JVM.
dependency() {
    printf '<dependency><groupId>%s</groupId><artifactId>%s</artifactId><version>%s</version><scope>compile</scope></dependency>' "$1" "$2" "$3"
}
{
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>'
    printf '<groupId>rocky</groupId><artifactId>rocky-core-jvm</artifactId><version>%s</version><packaging>jar</packaging><dependencies>' "$version"
    dependency org.jetbrains.kotlin kotlin-stdlib 2.4.20
    dependency org.jetbrains.kotlinx kotlinx-coroutines-core-jvm 1.10.2
    dependency org.jetbrains.kotlinx kotlinx-serialization-json-jvm 1.9.0
    dependency net.java.dev.jna jna 5.18.1
    printf '</dependencies></project>\n'
} >"$directory/rocky-core-jvm-$version.pom"
unzip -Z1 "$jar" | grep -E '^[^/]+-[^/]+/[^/]+\.(dylib|so|dll)$'

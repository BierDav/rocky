#!/usr/bin/env python3
"""Share sccache entries across Cargo target directories."""

import os
import sys

# A shell can discard Cargo variables such as CARGO_BIN_EXE_rocky-voter.
for name in ("CARGO_TARGET_DIR", "CARGO_BUILD_TARGET_DIR"):
    os.environ.pop(name, None)

os.execvp("sccache", ["sccache", *sys.argv[1:]])

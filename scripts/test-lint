#!/usr/bin/env python3
"""Check lint failure propagation without builds or external lint tools."""
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import tempfile
import tomllib
import unittest


SCRIPTS = Path(__file__).resolve().parent
WORKFLOW_CHECKS = ("actionlint", "test-test-tiers", "test-rust-publish",
                   "test-release-version", "test-lint")


class LintStatus(unittest.TestCase):
    def test_workflow_failures_survive_later_successes_and_other_modules_run(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts = root / "scripts"
            modules = scripts / "lint.d"
            modules.mkdir(parents=True)
            binary = root / "local/bin"
            binary.mkdir(parents=True)
            shutil.copy2(SCRIPTS / "lint", scripts / "lint")
            shutil.copy2(SCRIPTS / "lint.d/workflows", modules / "workflows")
            (modules / "after").write_text(
                'check() { echo after >> "$LINT_CALLS"; }\n')
            for name in (*WORKFLOW_CHECKS, "shellcheck"):
                target = (scripts if name.startswith("test-") else binary) / name
                target.write_text(
                    '#!/bin/sh\n'
                    'name=${0##*/}\n'
                    'echo "$name" >> "$LINT_CALLS"\n'
                    '[ "$name" != "$LINT_FAIL" ]\n')
                target.chmod(0o755)
            calls = root / "calls"
            for failing in ("", *WORKFLOW_CHECKS):
                with self.subTest(failing=failing or "none"):
                    calls.write_text("")
                    result = subprocess.run(
                        [str(scripts / "lint"), "workflows", "after"],
                        cwd=root, capture_output=True, text=True,
                        env=dict(os.environ, LINT_FAIL=failing, LINT_CALLS=str(calls)))
                    self.assertEqual(result.returncode, 1 if failing else 0, result.stderr)
                    completed = len(WORKFLOW_CHECKS) if not failing else WORKFLOW_CHECKS.index(failing) + 1
                    self.assertEqual(calls.read_text().splitlines(),
                                     [*WORKFLOW_CHECKS[:completed], "after"])
                    if failing:
                        self.assertIn("lint: failed: workflows", result.stderr)


class RustAttributes(unittest.TestCase):
    def test_allow_forms_including_inactive_and_nested_cfg_attr(self):
        violations = runpy.run_path(str(SCRIPTS / 'lint-rust'))['violations']
        source = '''#[allow(dead_code)]
#![allow(dead_code, reason = "still forbidden")]
#[cfg_attr(any(), allow(dead_code))]
#[cfg_attr(all(), cfg_attr(any(), allow(dead_code)), allow(unused))]
# /* comment */ ! [r#allow(dead_code)]
'''
        self.assertEqual(list(violations(source)), [1, 2, 3, 4, 4, 5])

    def test_comments_literals_and_other_attributes_are_not_exceptions(self):
        violations = runpy.run_path(str(SCRIPTS / 'lint-rust'))['violations']
        source = '''// #[allow(dead_code)]
/* outer /* #[allow(dead_code)] */ comment */
const TEXT: &str = "#[allow(dead_code)]";
const RAW: &str = r###"#[allow(dead_code)]"###;
const BYTE: &[u8] = br#"#[allow(dead_code)]"#;
#[doc = "#[allow(dead_code)]"]
#[expect(dead_code, reason = "fixture")]
fn unused<'a>() { let _ = '['; }
fn allow() {}
#[tool::allow(dead_code)]
'''
        self.assertEqual(list(violations(source)), [])

    def test_error_includes_replacement_and_source_location(self):
        with tempfile.TemporaryDirectory() as directory:
            source = Path(directory) / 'fixture.rs'
            source.write_text('\n#![allow(dead_code, reason = "fixture")]\n')
            result = subprocess.run([str(SCRIPTS / 'lint-rust'), str(source)],
                                    capture_output=True, text=True)
            self.assertEqual(result.returncode, 1)
            self.assertIn(f'{source}:2: error:', result.stderr)
            self.assertIn('use #[expect(lint, reason = "...")] instead', result.stderr)


class RustComments(unittest.TestCase):
    def test_only_documentation_comments_are_allowed(self):
        comments = runpy.run_path(str(SCRIPTS / 'lint-rust'))['comments']
        source = '''//! Crate docs.
/// Item docs.
/** Block docs. */
/*! Inner block docs. */
const URL: &str = "https://example.com // not a comment";
const RAW: &str = r#"/* not a comment */"#;
fn lifetime<'a>(value: &'a str) -> char { '/' }
// plain
let x = 1; // trailing
//// four slashes
/* block /* nested */ still */
/***/
/**/
'''
        self.assertEqual(list(comments(source)), [8, 9, 10, 11, 12, 13])

    def run_workspace(self, budgets, sources, *arguments):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'scripts').mkdir()
            shutil.copy2(SCRIPTS / 'lint-rust', root / 'scripts/lint-rust')
            (root / 'scripts/comment-budgets.toml').write_text('# Header.\n\n' + budgets)
            packages = []
            for package, source in sources.items():
                manifest = root / package / 'Cargo.toml'
                (manifest.parent / 'src').mkdir(parents=True)
                manifest.write_text('')
                (manifest.parent / 'src/lib.rs').write_text(source)
                name = Path(package).name
                packages.append({'name': name, 'id': name, 'manifest_path': str(manifest)})
            binary = root / 'bin'
            binary.mkdir()
            metadata = json.dumps({'packages': packages,
                                   'workspace_members': [p['id'] for p in packages]})
            (binary / 'cargo').write_text(f"#!/bin/sh\ncat <<'EOF'\n{metadata}\nEOF\n")
            (binary / 'cargo').chmod(0o755)
            result = subprocess.run(
                [str(root / 'scripts/lint-rust'), *arguments], capture_output=True, text=True,
                env=dict(os.environ, PATH=f'{binary}:{os.environ["PATH"]}'))
            return result, (root / 'scripts/comment-budgets.toml').read_text()

    def test_unbudgeted_packages_report_each_comment_and_vendored_code_is_exempt(self):
        result, _ = self.run_workspace('', {'crates/a': '\n// plain\n', 'vendor/b': '// upstream\n'})
        self.assertEqual(result.returncode, 1)
        self.assertIn('crates/a/src/lib.rs:2: error: plain comments are forbidden', result.stderr)
        self.assertNotIn('vendor', result.stderr)

    def test_a_budget_must_match_and_only_fix_lowers_it(self):
        two = '// one\n// two\n'
        result, _ = self.run_workspace('a = 2\n', {'crates/a': two})
        self.assertEqual(result.returncode, 0, result.stderr)
        result, _ = self.run_workspace('a = 1\n', {'crates/a': two})
        self.assertEqual(result.returncode, 1)
        self.assertIn('a: error: 2 plain comments exceed its budget of 1', result.stderr)
        result, _ = self.run_workspace('a = 3\n', {'crates/a': two})
        self.assertEqual(result.returncode, 1)
        self.assertIn('lower it with scripts/lint --fix', result.stderr)
        result, budgets = self.run_workspace('a = 3\nb = 1\n', {'crates/a': two, 'crates/b': ''},
                                             '--fix')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(budgets, '# Header.\n\na = 2\n')
        result, budgets = self.run_workspace('a = 1\n', {'crates/a': two}, '--fix')
        self.assertEqual(result.returncode, 1)
        self.assertEqual(budgets, '# Header.\n\na = 1\n')

    def test_budgets_name_workspace_packages(self):
        result, _ = self.run_workspace('gone = 1\n', {'crates/a': ''})
        self.assertEqual(result.returncode, 1)
        self.assertIn('gone is not a workspace package', result.stderr)


class ClippyConfiguration(unittest.TestCase):
    def test_shared_settings_reach_both_targets_and_wasm_stays_isolated(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts = root / 'scripts'
            (scripts / 'clippy-wasm').mkdir(parents=True)
            shutil.copy2(SCRIPTS / 'clippy', scripts / 'clippy')
            (root / 'clippy.toml').write_text(
                'allow-unwrap-in-tests = true\n'
                '[[enforced-import-renames]]\n'
                'path = "serde_json::Value"\n'
                'rename = "JsonValue"\n')
            (scripts / 'clippy-wasm/clippy.toml').write_text(
                'disallowed-methods = ["std::fs::read"]\n')
            binary = root / 'bin'
            binary.mkdir()
            cargo = binary / 'cargo'
            cargo.write_text('#!/bin/sh\n'
                             'cat "$CLIPPY_CONF_DIR/clippy.toml" > "$CLIPPY_CAPTURE"\n'
                             'echo "$CLIPPY_CONF_DIR" > "$CLIPPY_DIRECTORY"\n'
                             'exit "$CLIPPY_STATUS"\n')
            cargo.chmod(0o755)
            capture = root / 'config'
            config_directory = root / 'directory'
            environment = dict(os.environ, PATH=f'{binary}:{os.environ["PATH"]}',
                               CLIPPY_CONF_DIR='/ignored', CLIPPY_CAPTURE=str(capture),
                               CLIPPY_DIRECTORY=str(config_directory))
            generated_mtime = None
            for target in ([], ['--target', 'wasm32-unknown-unknown'],
                           ['--target=wasm32-unknown-unknown']):
                for status in (0, 17):
                    with self.subTest(target=target, status=status):
                        result = subprocess.run([str(scripts / 'clippy'), *target],
                                                cwd=root, capture_output=True, text=True,
                                                env=dict(environment, CLIPPY_STATUS=str(status)))
                        self.assertEqual(result.returncode, status, result.stderr)
                        config = tomllib.loads(capture.read_text())
                        self.assertTrue(config['allow-unwrap-in-tests'])
                        self.assertEqual(config['enforced-import-renames'],
                                         [{'path': 'serde_json::Value', 'rename': 'JsonValue'}])
                        self.assertEqual('disallowed-methods' in config, bool(target))
                        if target:
                            generated = Path(config_directory.read_text().strip())
                            self.assertEqual(generated.resolve(), (root / 'local/clippy-wasm').resolve())
                            self.assertEqual(list(generated.iterdir()), [generated / 'clippy.toml'])
                            mtime = (generated / 'clippy.toml').stat().st_mtime_ns
                            if generated_mtime is not None:
                                self.assertEqual(mtime, generated_mtime)
                            generated_mtime = mtime
                        else:
                            self.assertEqual(Path(config_directory.read_text().strip()).resolve(), root.resolve())
            (root / 'clippy.toml').write_text('disallowed-methods = []\n')
            duplicate = subprocess.run([str(scripts / 'clippy'), '--target=wasm32-unknown-unknown'],
                                       cwd=root, capture_output=True, text=True,
                                       env=dict(environment, CLIPPY_STATUS='0'))
            self.assertEqual(duplicate.returncode, 1)
            self.assertIn('browser restrictions must only be defined', duplicate.stderr)

    def test_browser_overlay_contains_only_browser_restrictions(self):
        overlay = tomllib.loads((SCRIPTS / 'clippy-wasm/clippy.toml').read_text())
        self.assertEqual(set(overlay), {'disallowed-methods', 'disallowed-types'})
        shared = (SCRIPTS.parent / 'clippy.toml').read_text()
        tomllib.loads(shared + '\n' + (SCRIPTS / 'clippy-wasm/clippy.toml').read_text())


if __name__ == "__main__":
    unittest.main()

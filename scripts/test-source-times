#!/usr/bin/env python3
"""Check Cargo cache reuse and changed-source invalidation against real builds."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time
import unittest

HELPER = Path(__file__).resolve().parent / "ci/source-times"


class SourceTimesTest(unittest.TestCase):
    def test_unchanged_sources_reuse_outputs_and_changed_sources_rebuild(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory) / "source"
            (root / "src").mkdir(parents=True)
            (root / "Cargo.toml").write_text('[package]\nname = "source-times-fixture"\nversion = "0.1.0"\nedition = "2024"\n')
            (root / ".cargo").mkdir()
            configuration = root / ".cargo/config.toml"
            configuration.write_text("# CI source tree: first\n")
            source = root / "src/main.rs"
            source.write_text('fn main() { println!("before"); }\n')
            cache = Path(directory) / "times.json"

            def normalize():
                subprocess.run([str(HELPER), str(cache)], cwd=root, check=True, capture_output=True)

            def build():
                result = subprocess.run(["cargo", "build", "--offline", "--message-format=json"],
                                        cwd=root, check=True, capture_output=True, text=True)
                return next(json.loads(line)["fresh"] for line in result.stdout.splitlines()
                            if json.loads(line).get("reason") == "compiler-artifact")

            normalize()
            self.assertFalse(build())
            normalized = source.stat().st_mtime_ns
            os.utime(source, ns=(time.time_ns(), time.time_ns() + 1_000_000_000))
            configuration.write_text("# CI source tree: second\n")
            normalize()
            self.assertEqual(source.stat().st_mtime_ns, normalized)
            self.assertTrue(build())
            source.write_text('fn main() { println!("after"); }\n')
            # Changed content must rebuild even if its archive timestamp is old.
            os.utime(source, ns=(normalized, normalized))
            normalize()
            self.assertFalse(build())
            result = subprocess.run([str(root / "target/debug/source-times-fixture")],
                                    check=True, capture_output=True, text=True)
            self.assertEqual(result.stdout.strip(), "after")


if __name__ == "__main__":
    unittest.main()

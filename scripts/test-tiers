#!/usr/bin/env python3
"""Run test tiers with shared builds and report correctness failures.

  scripts/test-tiers TIER... [--list] [--filter EXPR] [--cranelift] [--build=ARGS]... [--archive FILE]...

Tiers are unit, integration or e2e, as .config/test-tiers.toml defines them.
Each --build passes cargo build arguments (one string, such as "--workspace"),
built with scripts/cranelift if --cranelift is given; each --archive names a
nextest archive. The tier runs for each in turn; --list only prints its tests.

Unit tests run in process with libtest, so their times exclude process start.
Integration tests run in bounded batches; isolated tests and e2e use nextest.
Timing is diagnostic only;
assertion failures and hang timeouts fail the run.

A libtest test that fails reruns alone, up to ROCKY_TEST_RETRIES times (default
1, 0 for none); nextest tiers get the same count as NEXTEST_RETRIES. A test that
passes on a rerun is reported as flaky and does not fail the run.

Test processes keep their storage (TMPDIR) on a RAM-backed volume
(scripts/test-volume), or in ROCKY_TEST_TMPDIR when the caller made one, so
the flushes of the real durability path do not queue on the host's disk.
"""

import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / ".config" / "test-tiers.toml"
REPORTS = ROOT / "target" / "test-tiers"
TIERS = ("unit", "integration", "e2e")
# A unit test binary that runs longer than this has hung.
UNIT_BINARY_TIMEOUT = 300
CPUS = os.cpu_count() or 1
# Integration batches that run at once, each with up to four test threads.
BATCH_WORKERS = int(os.environ.get("ROCKY_TEST_BATCHES", max(1, CPUS // 3)))
# A test that took this long before runs in a batch of its own.
SOLO = 5.0
VOLUME = ROOT / "scripts" / "test-volume"
# The environment test processes get on top of this one's.
TEST_ENV = {}
# Reruns, each alone, of a libtest test that failed.
RETRIES = int(os.environ.get("ROCKY_TEST_RETRIES", "1"))
# Tests that failed and then passed alone, as "binary-id name".
FLAKY = []


def test_storage():
    """Points test processes' TMPDIR at a RAM-backed directory; returns its cleanup."""
    given = os.environ.get("ROCKY_TEST_TMPDIR")
    if given:
        TEST_ENV["TMPDIR"] = given
        return lambda: None
    owner = str(os.getpid())
    made = subprocess.run([str(VOLUME), "up", owner], stdout=subprocess.PIPE, text=True)
    directory = made.stdout.strip()
    if made.returncode != 0 or not directory:
        print("test-tiers: no test storage directory; tests use the default TMPDIR", file=sys.stderr)
        return lambda: None
    TEST_ENV["TMPDIR"] = directory
    return lambda: subprocess.run([str(VOLUME), "down", directory, owner])


def fail(message):
    print(f"test-tiers: {message}", file=sys.stderr)
    sys.exit(2)


def show(value):
    return f"{value * 1000:.1f}ms" if value < 1 else f"{value:.2f}s"


class Config:
    def __init__(self):
        data = tomllib.loads(CONFIG.read_text())
        self.tiers = data
        e2e = data["e2e"]["filter"]
        integration = data["integration"]["filter"]
        self.filters = {
            "e2e": f"({e2e})",
            "integration": f"({integration}) & !({e2e})",
            "unit": f"!({integration}) & !({e2e})",
        }


class Source:
    """One build of the tests: cargo build arguments or a nextest archive."""

    def __init__(self, build=None, archive=None, cranelift=False):
        self.cargo = ["cargo"]
        self.target_dir = None
        if archive:
            self.name = Path(archive).name.split(".")[0]
            extract = REPORTS / "extract" / self.name
            extract.mkdir(parents=True, exist_ok=True)
            self.target_dir = extract / "target"
            self.run_args = ["--archive-file", archive, "--workspace-remap", str(ROOT)]
            self.list_args = self.run_args + ["--extract-to", str(extract), "--extract-overwrite"]
            # After the first listing extracts it, every command reuses the
            # extracted build instead of unpacking the archive again.
            metadata = self.target_dir / "nextest"
            self.reuse_args = ["--binaries-metadata", str(metadata / "binaries-metadata.json"),
                               "--cargo-metadata", str(metadata / "cargo-metadata.json"),
                               "--target-dir-remap", str(self.target_dir),
                               "--workspace-remap", str(ROOT)]
        else:
            self.name = re.sub(r"[^a-z0-9]+", "-", build.lower()).strip("-") or "default"
            if cranelift:
                self.cargo = [str(ROOT / "scripts" / "cranelift"), "cargo"]
            self.run_args = ["--locked", *shlex.split(build)]
            self.list_args = self.run_args

    def list(self, expr, ignored="default"):
        """The matching tests as (suite, name) pairs; suite is nextest's binary record."""
        listing = subprocess.run(
            [*self.cargo, "nextest", "list", *self.list_args, "--message-format", "json",
             "--run-ignored", ignored, "-E", expr],
            cwd=ROOT, stdout=subprocess.PIPE, text=True,
        )
        if listing.returncode != 0:
            fail(f"listing the tests of {self.name} failed with exit {listing.returncode}")
        if hasattr(self, "reuse_args"):
            self.run_args = self.list_args = self.reuse_args
        out = listing.stdout
        listed = json.loads(out)
        meta = listed["rust-build-meta"]
        target = self.target_dir or Path(meta["target-directory"])
        tests = []
        for suite in listed["rust-suites"].values():
            suite["non-test-environment"] = {
                f"CARGO_BIN_EXE_{binary['name']}": str(target / binary["path"])
                for binary in meta["non-test-binaries"].get(suite["package-id"], [])
                if binary["kind"] == "bin-exe"
            }
            for name, case in suite["testcases"].items():
                if case["filter-match"]["status"] == "matches":
                    tests.append((suite, name))
        return tests


def libtest(suite, names, threads=None):
    """Runs tests of one binary in process; returns {name: (event, seconds,
    stdout)}, stderr and the exit code, which is None if the binary timed out."""
    cmd = [suite["binary-path"], "--exact", "-Zunstable-options", "--format", "json",
           "--report-time", *names]
    if threads:
        cmd += ["--test-threads", str(threads)]
    # libtest's JSON format is unstable; RUSTC_BOOTSTRAP enables it at run time
    # only, so it never reaches rustc or cargo's fingerprints.
    env = dict(os.environ, RUSTC_BOOTSTRAP="1", CARGO_MANIFEST_DIR=suite["cwd"], **TEST_ENV)
    env.update(suite.get("non-test-environment", {}))
    try:
        proc = subprocess.run(cmd, cwd=suite["cwd"], env=env, capture_output=True,
                              text=True, timeout=UNIT_BINARY_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        # The output read before the kill comes as bytes even for a text run.
        stdout, stderr = ((stream or b"").decode(errors="replace")
                          for stream in (error.stdout, error.stderr))
        return test_events(stdout, unfinished="timed out"), stderr, None
    return test_events(proc.stdout, unfinished="unfinished"), proc.stderr, proc.returncode


def test_events(stdout, unfinished):
    """Each started test's result from libtest's JSON lines. A test that started
    but has no result was still running when the binary stopped; libtest's
    `timeout` event only warns that a test is slow, so it is not a result."""
    results = {}
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("type") != "test":
            continue
        name = event.get("name")
        if event.get("event") == "started":
            results.setdefault(name, (unfinished, 0.0, ""))
        elif event.get("event") in ("ok", "failed"):
            results[name] = (event["event"], event.get("exec_time", 0.0), event.get("stdout", ""))
    return results


def judge(source, suite, names, run):
    """Splits one libtest run of `names` into timings and failures. Tests that
    passed count even if the binary failed or timed out later; a test that never
    started is missing."""
    events, stderr, code = run
    timed, failed = [], []
    if code is None:
        failed.append(f"{suite['binary-id']} timed out after {UNIT_BINARY_TIMEOUT}s")
    elif code != 0:
        failed.append(f"{suite['binary-id']} exited {code}")
    for name in names:
        event, took, stdout = events.get(name, ("missing", 0.0, ""))
        if event == "ok":
            timed.append((source, suite, name, took))
        else:
            failed.append(f"{suite['binary-id']} {name}: {event}")
            show_output(suite, name, event, stdout)
    if (not events or code is None) and stderr:
        print(stderr, file=sys.stderr)
    return timed, failed


def rerun_failures(source, suite, names, judged):
    """Reruns each test of `names` that did not pass, alone, up to RETRIES
    times. A test that passes is recorded in FLAKY and its failure dropped;
    the binary's own failure is dropped once none of its tests still fail."""
    timed, failed = judged
    passed = {name for _, _, name, _ in timed}
    again = [name for name in names if name not in passed]
    if not failed or not again or RETRIES <= 0:
        return timed, failed
    recovered = []
    for name in again:
        for _ in range(RETRIES):
            completed, _ = judge(source, suite, [name], libtest(suite, [name], threads=1))
            if completed:
                timed = timed + completed
                recovered.append(name)
                break
    if not recovered:
        return timed, failed
    binary = suite["binary-id"]
    FLAKY.extend(f"{binary} {name}" for name in recovered)
    if len(recovered) == len(again):
        return timed, []
    gone = tuple(f"{binary} {name}: " for name in recovered)
    return timed, [problem for problem in failed if not problem.startswith(gone)]


def show_output(suite, name, event, stdout):
    """Prints a failed test's captured output under its name; a test that
    returns an error prints only `Error: ...`, with no panic line to name it."""
    print(f"test-tiers: ---- {suite['binary-id']} {name}: {event} ----", file=sys.stderr)
    if stdout:
        print(stdout.rstrip("\n"), file=sys.stderr)


def run_unit(source, tests):
    """Runs the unit tests binary by binary; returns timings, failures and wall time."""
    by_binary = {}
    for suite, name in tests:
        by_binary.setdefault(suite["binary-path"], (suite, []))[1].append(name)
    timed, failed, wall = [], [], 0.0
    for suite, names in by_binary.values():
        start = time.monotonic()
        run = libtest(suite, names)
        completed, problems = rerun_failures(source, suite, names, judge(source, suite, names, run))
        wall += time.monotonic() - start
        timed.extend(completed)
        failed.extend(problems)
    return timed, failed, wall


def batches(tests, size=32, durations=None):
    """Groups each binary's tests in batches of `size`. A test that took at
    least SOLO seconds in an earlier run gets a batch of its own."""
    durations = durations or {}
    by_binary = {}
    for suite, name in tests:
        by_binary.setdefault(suite["binary-path"], (suite, []))[1].append(name)
    groups = []
    for suite, names in by_binary.values():
        took = lambda name: durations.get((suite["binary-id"], name), 0.0)
        solo = [name for name in names if took(name) >= SOLO]
        rest = [name for name in names if took(name) < SOLO]
        groups += [(suite, [name]) for name in solo]
        groups += [(suite, rest[first:first + size]) for first in range(0, len(rest), size)]
    return groups


def earlier_durations(tier):
    """Seconds each test took in this checkout's earlier runs of `tier`; they
    only order the work."""
    durations = {}
    for report in REPORTS.glob(f"{tier}-*.tsv"):
        for line in report.read_text().splitlines():
            took, binary, name = line.split("\t", 2)
            key = (binary, name)
            durations[key] = max(durations.get(key, 0.0), float(took))
    return durations


def run_batches(source, tests, durations=None):
    start = time.monotonic()
    durations = durations or {}
    # Longest first, so the slowest batches do not start last.
    def predicted(group):
        suite, names = group
        return sum(durations.get((suite["binary-id"], name), 1.0) for name in names)
    groups = sorted(batches(tests, durations=durations), key=lambda group: -predicted(group))
    def run(group):
        suite, names = group
        run = libtest(suite, names, threads=min(4, CPUS))
        return rerun_failures(source, suite, names, judge(source, suite, names, run))
    timed, failed = [], []
    with ThreadPoolExecutor(max_workers=BATCH_WORKERS) as pool:
        for completed, problems in pool.map(run, groups):
            timed.extend(completed)
            failed.extend(problems)
    return timed, failed, time.monotonic() - start


def run_nextest(source, tier, expr, tests):
    """Runs the tier with nextest; returns timings, failures and wall time."""
    by_key = {(suite["binary-id"], name): suite for suite, name in tests}
    cmd = [*source.cargo, "nextest", "run", *source.run_args, "--profile", tier, "-E", expr]
    if tier == "e2e":
        cmd += ["--run-ignored", "all"]
    # nextest writes reports under the workspace's target directory.
    junit = ROOT / "target" / "nextest" / tier / "junit.xml"
    junit.unlink(missing_ok=True)
    start = time.monotonic()
    code = subprocess.run(cmd, cwd=ROOT, env=dict(os.environ, **TEST_ENV)).returncode
    wall = time.monotonic() - start
    if not junit.exists():
        fail(f"nextest wrote no {junit}; exit {code}")
    timed, failed = [], []
    for case in ET.parse(junit).iter("testcase"):
        key = (case.get("classname"), case.get("name"))
        suite = by_key.get(key)
        if suite is None:
            continue
        if case.find("failure") is not None or case.find("error") is not None:
            failed.append(" ".join(key))
        else:
            timed.append((source, suite, key[1], float(case.get("time", 0))))
    if code != 0 and not failed:
        failed.append(f"nextest exited {code}")
    return timed, failed, wall


def run_tier(source, config, tier, expr, tests):
    if tier == "unit":
        return run_unit(source, tests)
    if tier == "e2e":
        return run_nextest(source, tier, expr, tests)
    isolated = config.tiers[tier].get("isolated-filter")
    timed, failed, wall = [], [], 0.0
    if isolated:
        isolated_expr = f"({expr}) & ({isolated})"
        selected = source.list(isolated_expr)
        keys = {(suite["binary-id"], name) for suite, name in selected}
        tests = [(suite, name) for suite, name in tests if (suite["binary-id"], name) not in keys]
        if selected:
            timed, failed, wall = run_nextest(source, tier, isolated_expr, selected)
    if tests:
        extra_timed, extra_failed, extra_wall = run_batches(source, tests, earlier_durations(tier))
        timed.extend(extra_timed)
        failed.extend(extra_failed)
        wall += extra_wall
    return timed, failed, wall


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("tier", choices=TIERS, nargs="+")
    parser.add_argument("--build", action="append", default=[])
    parser.add_argument("--archive", action="append", default=[])
    parser.add_argument("--cranelift", action="store_true",
                        help="build with scripts/cranelift")
    parser.add_argument("--filter", default="all()", help="intersect each tier with this test filter")
    parser.add_argument("--list", action="store_true", help="print the tier's tests and exit")
    args = parser.parse_args()
    # nextest already parallelizes tests across cores. Each Tokio runtime needs
    # two workers for concurrency, not another whole machine's worth of threads.
    os.environ.setdefault("TOKIO_WORKER_THREADS", "2")
    # Test threads poll the unoptimized workspace crates' deep futures; Cargo's
    # [env] sets the same for `cargo test` and nextest.
    os.environ.setdefault("RUST_MIN_STACK", str(16 << 20))
    os.environ.setdefault("NEXTEST_RETRIES", str(max(RETRIES, 0)))
    config = Config()
    builds = args.build or ([] if args.archive else ["--workspace"])
    sources = [Source(build=b, cranelift=args.cranelift) for b in builds]
    sources += [Source(archive=a) for a in args.archive]
    REPORTS.mkdir(parents=True, exist_ok=True)
    states = {tier: {"problems": [], "timed": [], "wall": 0.0}
              for tier in dict.fromkeys(args.tier)}
    cleanup = (lambda: None) if args.list else test_storage()
    try:
        # Finish all tiers before changing Cargo's feature configuration.
        for source in sources:
            for tier, state in states.items():
                expr = f"({config.filters[tier]}) & ({args.filter})"
                tests = source.list(expr, ignored="all" if tier == "e2e" else "default")
                if args.list:
                    for suite, name in tests:
                        print(f"{suite['binary-id']} {name}")
                    continue
                print(f"test-tiers: {tier}: {len(tests)} tests from {source.name}, "
                      f"{CPUS} host cores", flush=True)
                if not tests:
                    continue
                timed, failed, wall = run_tier(source, config, tier, expr, tests)
                state["problems"] += [f"failed: {f}" for f in failed]
                state["timed"] += timed
                state["wall"] += wall
                with open(REPORTS / f"{tier}-{source.name}.tsv", "w") as report:
                    for _, suite, name, took in sorted(timed, key=lambda t: -t[3]):
                        report.write(f"{took:.4f}\t{suite['binary-id']}\t{name}\n")
    finally:
        cleanup()
    if args.list:
        return
    failed = False
    for tier, state in states.items():
        failed = finish_tier(config, tier, state) or failed
    report_flaky()
    sys.exit(1 if failed else 0)


def report_flaky():
    """Names each test that failed and then passed alone; in GitHub Actions
    also as a warning annotation, so a flaky test is seen without failing."""
    for test in FLAKY:
        print(f"test-tiers: flaky: {test} failed, then passed alone", file=sys.stderr)
        if os.environ.get("GITHUB_ACTIONS") == "true":
            print(f"::warning title=Flaky test::{test} failed, then passed alone")


def finish_tier(config, tier, state):
    print(f"test-tiers: {tier}: {len(state['timed'])} passed, wall {show(state['wall'])}")
    for problem in state["problems"]:
        print(f"test-tiers: {problem}", file=sys.stderr)
    return bool(state["problems"])


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Run test tiers with shared builds and enforce their combined budgets.

  scripts/test-tiers TIER... [--list] [--filter EXPR] [--cranelift] [--build=ARGS]... [--archive FILE]...

Tiers are unit, integration or e2e, as .config/test-tiers.toml defines them.
Each --build passes cargo build arguments (one string, such as "--workspace"),
built with scripts/cranelift if --cranelift is given; each --archive names a
nextest archive. The tier runs for each in turn; --list only prints its tests.

Unit tests run in process with libtest, so their times exclude process start.
Integration and e2e tests run with nextest. A test over its budget is re-run
alone; it fails when its best run, scaled by the host's load, still exceeds it.
"""

import argparse
import datetime
import json
import math
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / ".config" / "test-tiers.toml"
REPORTS = ROOT / "target" / "test-tiers"
TIERS = ("unit", "integration", "e2e")
RERUNS = 3
# A unit test binary that runs longer than this has hung.
UNIT_BINARY_TIMEOUT = 120
CPUS = os.cpu_count() or 1


def fail(message):
    print(f"test-tiers: {message}", file=sys.stderr)
    sys.exit(2)


def seconds(text):
    match = re.fullmatch(r"(\d+(?:\.\d+)?)(ms|s|m)", text)
    if not match:
        fail(f"bad duration {text!r}")
    value, unit = float(match[1]), match[2]
    return value * {"ms": 0.001, "s": 1, "m": 60}[unit]


def show(value):
    if value == math.inf:
        return "a failure"
    return f"{value * 1000:.1f}ms" if value < 1 else f"{value:.2f}s"


def load():
    return os.getloadavg()[0]


def load_factor(before, after):
    """How much slower a CPU-bound test ran because other work used the cores."""
    return max(1.0, min(before, after) / CPUS)


class Config:
    def __init__(self):
        data = tomllib.loads(CONFIG.read_text())
        self.tiers = data
        e2e = data["e2e"]["filter"]
        integration = data["integration"]["filter"]
        self.filters = {
            "e2e": f"({e2e})",
            "integration": f"({integration}) & !({e2e})",
            "unit": f"!({integration}) & !({e2e})",
        }
        self.exceptions = {}
        today = datetime.date.today()
        for entry in data.get("exception", []):
            missing = {"test", "limit", "measured", "cause", "expires"} - entry.keys()
            if missing:
                fail(f"exception {entry.get('test')!r} lacks {', '.join(sorted(missing))}")
            if entry["expires"] < today:
                fail(f"exception for {entry['test']!r} expired on {entry['expires']}")
            self.exceptions[entry["test"]] = seconds(entry["limit"])

    def per_test(self, tier, key):
        budget = self.tiers[tier].get("per-test")
        if budget is None:
            return math.inf
        return self.exceptions.get(key, seconds(budget))


class Source:
    """One build of the tests: cargo build arguments or a nextest archive."""

    def __init__(self, build=None, archive=None, cranelift=False):
        self.cargo = ["cargo"]
        self.target_dir = None
        if archive:
            self.name = Path(archive).name.split(".")[0]
            extract = REPORTS / "extract" / self.name
            extract.mkdir(parents=True, exist_ok=True)
            self.target_dir = extract / "target"
            self.run_args = ["--archive-file", archive, "--workspace-remap", str(ROOT)]
            self.list_args = self.run_args + ["--extract-to", str(extract), "--extract-overwrite"]
        else:
            self.name = re.sub(r"[^a-z0-9]+", "-", build.lower()).strip("-") or "default"
            if cranelift:
                self.cargo = [str(ROOT / "scripts" / "cranelift"), "cargo"]
            self.run_args = ["--locked", *shlex.split(build)]
            self.list_args = self.run_args

    def list(self, expr, ignored="default"):
        """The matching tests as (suite, name) pairs; suite is nextest's binary record."""
        listing = subprocess.run(
            [*self.cargo, "nextest", "list", *self.list_args, "--message-format", "json",
             "--run-ignored", ignored, "-E", expr],
            cwd=ROOT, stdout=subprocess.PIPE, text=True,
        )
        if listing.returncode != 0:
            fail(f"listing the tests of {self.name} failed with exit {listing.returncode}")
        out = listing.stdout
        listed = json.loads(out)
        meta = listed["rust-build-meta"]
        target = self.target_dir or Path(meta["target-directory"])
        tests = []
        for suite in listed["rust-suites"].values():
            suite["non-test-environment"] = {
                f"CARGO_BIN_EXE_{binary['name']}": str(target / binary["path"])
                for binary in meta["non-test-binaries"].get(suite["package-id"], [])
                if binary["kind"] == "bin-exe"
            }
            for name, case in suite["testcases"].items():
                if case["filter-match"]["status"] == "matches":
                    tests.append((suite, name))
        return tests


def libtest(suite, names, threads=None):
    """Runs tests of one binary in process; returns {name: (event, seconds)} and output."""
    cmd = [suite["binary-path"], "--exact", "-Zunstable-options", "--format", "json",
           "--report-time", *names]
    if threads:
        cmd += ["--test-threads", str(threads)]
    # libtest's JSON format is unstable; RUSTC_BOOTSTRAP enables it at run time
    # only, so it never reaches rustc or cargo's fingerprints.
    env = dict(os.environ, RUSTC_BOOTSTRAP="1", CARGO_MANIFEST_DIR=suite["cwd"])
    env.update(suite.get("non-test-environment", {}))
    try:
        proc = subprocess.run(cmd, cwd=suite["cwd"], env=env, capture_output=True,
                              text=True, timeout=UNIT_BINARY_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        return {}, f"timed out after {UNIT_BINARY_TIMEOUT}s\n{error.stdout or ''}"
    results = {}
    for line in proc.stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("type") == "test" \
                and event.get("event") in ("ok", "failed", "timeout"):
            results[event["name"]] = (event["event"], event.get("exec_time", 0.0),
                                      event.get("stdout", ""))
    return results, proc.stderr


def alone(suite, name):
    """The test's run time alone in process, scaled by load, or None if it failed."""
    before = load()
    results, _ = libtest(suite, [name], threads=1)
    factor = load_factor(before, load())
    event, took, _ = results.get(name, ("failed", 0.0, ""))
    return (took / factor, factor) if event == "ok" else (None, factor)


def judge(config, tier, timed, factor, confirmed):
    """Returns tests still over budget when re-run alone, scaled by host load.

    A test's first run competes with other tests and can include scheduler
    stalls of any size. Confirm even a large spike before rejecting it.

    confirmed maps a test to (alone, in the run) from its last passing re-run.
    A test is not re-run while that alone time, grown as much as its time in
    the run has, stays within three quarters of its budget.
    """
    over = []
    for source, suite, name, took in timed:
        key = f"{suite['binary-id']} {name}"
        limit = config.per_test(tier, key)
        if took <= limit:
            continue
        if key in confirmed:
            alone_before, took_before = confirmed[key]
            if alone_before * max(1.0, took / took_before) <= 0.75 * limit:
                continue
        best, rerun_factor = math.inf, factor
        for _ in range(RERUNS):
            scaled, rerun_factor = alone(suite, name)
            if scaled is None:
                break
            best = min(best, scaled)
            if best <= limit:
                break
        how = "alone"
        if best <= limit:
            confirmed[key] = (best, took)
        verdict = "ok" if best <= limit else "OVER"
        print(f"  {verdict:4} {key}: {show(took)} in the run, {show(best)} {how} "
              f"(load x{rerun_factor:.1f}), budget {show(limit)}", flush=True)
        if best > limit:
            confirmed.pop(key, None)
            over.append((key, took, best, limit))
    return over


def run_unit(source, tests):
    """Runs the unit tests binary by binary; returns timings, failures and wall time."""
    by_binary = {}
    for suite, name in tests:
        by_binary.setdefault(suite["binary-path"], (suite, []))[1].append(name)
    timed, failed, wall = [], [], 0.0
    for suite, names in by_binary.values():
        start = time.monotonic()
        results, stderr = libtest(suite, names)
        wall += time.monotonic() - start
        for name in names:
            event, took, stdout = results.get(name, ("missing", 0.0, ""))
            if event == "ok":
                timed.append((source, suite, name, took))
            else:
                failed.append(f"{suite['binary-id']} {name}: {event}")
                if stdout:
                    print(stdout, file=sys.stderr)
        if not results and stderr:
            print(stderr, file=sys.stderr)
    return timed, failed, wall


def run_nextest(source, tier, expr, tests):
    """Runs the tier with nextest; returns timings, failures and wall time."""
    by_key = {(suite["binary-id"], name): suite for suite, name in tests}
    cmd = [*source.cargo, "nextest", "run", *source.run_args, "--profile", tier, "-E", expr]
    if tier == "e2e":
        cmd += ["--run-ignored", "all"]
    # nextest writes reports under the workspace's target directory.
    junit = ROOT / "target" / "nextest" / tier / "junit.xml"
    junit.unlink(missing_ok=True)
    start = time.monotonic()
    code = subprocess.run(cmd, cwd=ROOT).returncode
    wall = time.monotonic() - start
    if not junit.exists():
        fail(f"nextest wrote no {junit}; exit {code}")
    timed, failed = [], []
    for case in ET.parse(junit).iter("testcase"):
        key = (case.get("classname"), case.get("name"))
        suite = by_key.get(key)
        if suite is None:
            continue
        if case.find("failure") is not None or case.find("error") is not None:
            failed.append(" ".join(key))
        else:
            timed.append((source, suite, key[1], float(case.get("time", 0))))
    if code != 0 and not failed:
        failed.append(f"nextest exited {code}")
    return timed, failed, wall


def run_tier(source, config, tier, expr, tests):
    """Keep explicitly exempt tests functional, outside the suite's clock."""
    exemption = config.tiers[tier].get("suite-exempt-filter")
    if not exemption:
        run = run_unit(source, tests) if tier == "unit" else run_nextest(source, tier, expr, tests)
        return (*run, 0.0)
    if tier == "unit":
        fail("unit tests cannot be exempt from the suite budget")
    exempt_expr = f"({expr}) & ({exemption})"
    exempt = source.list(exempt_expr, ignored="all" if tier == "e2e" else "default")
    keys = {(suite["binary-id"], name) for suite, name in exempt}
    regular = [(suite, name) for suite, name in tests if (suite["binary-id"], name) not in keys]
    timed, failed, wall = [], [], 0.0
    if regular:
        timed, failed, wall = run_nextest(source, tier, f"({expr}) & !({exemption})", regular)
    exempt_wall = 0.0
    if exempt:
        print(f"test-tiers: {tier}: {len(exempt)} suite-budget-exempt tests from {source.name}; "
              "failures and nextest timeouts still apply", flush=True)
        extra_timed, extra_failed, exempt_wall = run_nextest(source, tier, exempt_expr, exempt)
        timed += extra_timed
        failed += extra_failed
    return timed, failed, wall, exempt_wall


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("tier", choices=TIERS, nargs="+")
    parser.add_argument("--build", action="append", default=[])
    parser.add_argument("--archive", action="append", default=[])
    parser.add_argument("--cranelift", action="store_true",
                        help="build with scripts/cranelift")
    parser.add_argument("--filter", default="all()", help="intersect each tier with this test filter")
    parser.add_argument("--list", action="store_true", help="print the tier's tests and exit")
    args = parser.parse_args()
    config = Config()
    builds = args.build or ([] if args.archive else ["--workspace"])
    sources = [Source(build=b, cranelift=args.cranelift) for b in builds]
    sources += [Source(archive=a) for a in args.archive]
    REPORTS.mkdir(parents=True, exist_ok=True)
    states = {tier: {"problems": [], "timed": [], "wall": 0.0, "exempt": 0.0, "factors": []}
              for tier in dict.fromkeys(args.tier)}
    # Finish all tiers before changing Cargo's feature configuration.
    for source in sources:
        for tier, state in states.items():
            expr = f"({config.filters[tier]}) & ({args.filter})"
            tests = source.list(expr, ignored="all" if tier == "e2e" else "default")
            if args.list:
                for suite, name in tests:
                    print(f"{suite['binary-id']} {name}")
                continue
            print(f"test-tiers: {tier}: {len(tests)} tests from {source.name}, "
                  f"load {load():.1f} on {CPUS} cores", flush=True)
            if not tests:
                continue
            before = load()
            timed, failed, wall, exempt_wall = run_tier(source, config, tier, expr, tests)
            state["factors"].append(load_factor(before, load()))
            state["problems"] += [f"failed: {f}" for f in failed]
            state["timed"] += timed
            state["wall"] += wall
            state["exempt"] += exempt_wall
            with open(REPORTS / f"{tier}-{source.name}.tsv", "w") as report:
                for _, suite, name, took in sorted(timed, key=lambda t: -t[3]):
                    report.write(f"{took:.4f}\t{suite['binary-id']}\t{name}\n")
    if args.list:
        return
    failed = False
    for tier, state in states.items():
        failed = finish_tier(config, tier, state) or failed
    sys.exit(1 if failed else 0)


def finish_tier(config, tier, state):
    problems, timed_all = state["problems"], state["timed"]
    wall_total, exempt_total, factors = state["wall"], state["exempt"], state["factors"]

    factor = min(factors, default=1.0)
    # Local only: CI re-runs every test over budget.
    cache = REPORTS / f"confirmed-{tier}.json"
    confirmed = {}
    if not os.environ.get("CI") and cache.exists():
        confirmed = {k: tuple(v) for k, v in json.loads(cache.read_text()).items()}
    over = judge(config, tier, timed_all, factor, confirmed)
    if not os.environ.get("CI"):
        cache.write_text(json.dumps(confirmed, indent=0, sort_keys=True))
    problems += [f"over the {tier} budget: {key}, {show(best)}, budget {show(limit)}"
                 for key, _, best, limit in over]

    suite_budget = seconds(config.tiers[tier]["suite"])
    scaled = wall_total / factor
    print(f"test-tiers: {tier}: {len(timed_all)} passed, wall {show(wall_total)}, "
          f"{show(scaled)} at load x{factor:.1f}, budget {show(suite_budget)}")
    if exempt_total:
        print(f"test-tiers: {tier}: additional exempt wall {show(exempt_total)}; "
              f"total elapsed {show(wall_total + exempt_total)}")
    if scaled > suite_budget:
        problems.append(f"the {tier} suite took {show(scaled)} scaled by load, "
                        f"over its {show(suite_budget)} budget")
    for problem in problems:
        print(f"test-tiers: {problem}", file=sys.stderr)
    return bool(problems)


if __name__ == "__main__":
    main()

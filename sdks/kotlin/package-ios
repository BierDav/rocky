#!/bin/sh
# Publishes the arm64 iOS SDK and static XCFramework to a local repository.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
[ "$(uname -s)" = Darwin ] || { echo 'package-ios requires macOS/Xcode' >&2; exit 1; }
export IPHONEOS_DEPLOYMENT_TARGET=13.0
cargo build --manifest-path sdks/native/Cargo.toml --locked --features bindgen
for target in aarch64-apple-ios aarch64-apple-ios-sim; do
    cargo build --manifest-path sdks/native/Cargo.toml --locked --lib --target "$target"
done
mkdir -p local/ios-build
sdks/native/target/debug/rocky-bindgen generate-native \
    sdks/native/target/debug/librocky_uniffi.dylib local/ios-build/bindings
python3 sdks/kotlin/tooling/ios-package.py prepare "$repo_root"
KOTLIN_CLI_JAVA_OPTIONS="${KOTLIN_CLI_JAVA_OPTIONS:-} -Dmaven.repo.local=$repo_root/local/packaged-ios/maven" \
    ./kotlin publish --project-dir local/ios-build/project mavenLocal
python3 sdks/kotlin/tooling/ios-package.py finish "$repo_root"

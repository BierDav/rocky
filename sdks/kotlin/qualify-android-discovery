#!/bin/sh
# Phase 15's Android gate, on a booted emulator or the AVD $ROCKY_ANDROID_AVD: while local discovery
# is on, RockyLifecycle holds the Wi-Fi multicast lock; in the background it releases it.
# Needs the published Android runtime (sdks/kotlin/android-runtime/README.md).
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
package=rocky.check.discovery
tag=RockyDiscoveryCheck
sdk=${ANDROID_HOME:-$HOME/Library/Android/sdk}
./kotlin build -m android-discovery-check
apk=$(find build -type f -name '*-debug.apk' -path '*android-discovery-check*' | head -n 1)
[ -n "$apk" ] || { echo 'cannot find the check APK' >&2; exit 1; }
device=$(adb devices | awk '$2 == "device" && $1 ~ /^emulator-/ { print $1; exit }')
started=
if [ -z "$device" ]; then
    [ -n "${ROCKY_ANDROID_AVD:-}" ] || { echo 'boot an emulator or name one in ROCKY_ANDROID_AVD' >&2; exit 1; }
    "$sdk/emulator/emulator" -avd "$ROCKY_ANDROID_AVD" -no-window -no-audio -no-snapshot-save >/dev/null 2>&1 &
    started=$!
    for _ in $(seq 1 120); do
        device=$(adb devices | awk '$2 == "device" && $1 ~ /^emulator-/ { print $1; exit }')
        [ -n "$device" ] && [ "$(adb -s "$device" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
        sleep 2
    done
fi
[ -n "$device" ] || { echo 'no emulator came up' >&2; exit 1; }
cleanup() {
    adb -s "$device" uninstall "$package" >/dev/null 2>&1 || true
    [ -z "$started" ] || adb -s "$device" emu kill >/dev/null 2>&1 || true
}
trap cleanup EXIT
adb -s "$device" install -r "$apk" >/dev/null
adb -s "$device" logcat -c
# The line the app logs once a lifecycle transition was applied.
await() { # pattern
    for _ in $(seq 1 60); do
        line=$(adb -s "$device" logcat -d -s "$tag:I" | grep -E "$1" | tail -n 1 || true)
        [ -z "$line" ] || { echo "$line"; return 0; }
        sleep 1
    done
    adb -s "$device" logcat -d -s "$tag:*" >&2
    echo "no log line matched: $1" >&2
    return 1
}
held() { adb -s "$device" shell dumpsys wifi | grep -c 'Multicaster{rocky-discovery' || true; }
adb -s "$device" shell am start -W -n "$package/.CheckActivity" >/dev/null
await 'foreground=true lock=true local=On'
[ "$(held)" -gt 0 ] || { echo 'the system does not list the multicast lock' >&2; exit 1; }
adb -s "$device" shell input keyevent KEYCODE_HOME
await 'foreground=false lock=false local=Off'
[ "$(held)" -eq 0 ] || { echo 'the multicast lock is still held in the background' >&2; exit 1; }
adb -s "$device" shell am start -W -n "$package/.CheckActivity" >/dev/null
await 'foreground=true lock=true local=On' >/dev/null
echo 'Android discovery: the multicast lock is held in the foreground and released in the background'

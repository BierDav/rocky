#!/bin/sh
# Build JNA resources without containers; see docs/runtime/desktop-cross-build.md.
set -eu

die() { echo "build-desktop: $*" >&2; exit 1; }
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
PATH="$root/local/bin:$PATH"
out=${1:-$root/sdks/native/target/desktop-natives}
mkdir -p "$out"
out=$(CDPATH='' cd -- "$out" && pwd)
[ $# -eq 0 ] || shift
if [ $# -eq 0 ]; then
    [ "$(uname -s)" = Darwin ] || die "the complete matrix needs macOS/Xcode; pass explicit Rust targets on other hosts"
    set -- aarch64-apple-darwin x86_64-apple-darwin x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu x86_64-pc-windows-gnu
fi

for target do
    case "$target" in
        aarch64-apple-darwin) prefix=darwin-aarch64; library=librocky_uniffi.dylib; compiler= ;;
        x86_64-apple-darwin) prefix=darwin-x86-64; library=librocky_uniffi.dylib; compiler= ;;
        x86_64-unknown-linux-gnu) prefix=linux-x86-64; library=librocky_uniffi.so; compiler=linux ;;
        aarch64-unknown-linux-gnu) prefix=linux-aarch64; library=librocky_uniffi.so; compiler=linux ;;
        x86_64-pc-windows-gnu) prefix=win32-x86-64; library=rocky_uniffi.dll; compiler=x86_64-w64-mingw32
            ;;
        *) die "unsupported target $target" ;;
    esac
    if [ "$compiler" = linux ]; then
        compiler=$target
        if ! command -v "$compiler-gcc" >/dev/null; then
            compiler=${target%%-*}-linux-gnu
        fi
    fi
    rustup target add "$target"
    (
        if [ -n "$compiler" ]; then
            command -v "$compiler-gcc" >/dev/null || die "missing $compiler-gcc; see docs/runtime/desktop-cross-build.md"
            cargo_target=$(echo "$target" | tr '[:lower:]-' '[:upper:]_')
            cc_target=$(echo "$target" | tr - _)
            export "CARGO_TARGET_${cargo_target}_LINKER=$compiler-gcc"
            export "CC_${cc_target}=$compiler-gcc"
            export "AR_${cc_target}=$compiler-ar"
        fi
        cargo build --manifest-path sdks/native/Cargo.toml --locked --lib --target "$target"
    )
    mkdir -p "$out/$prefix"
    cp "${CARGO_TARGET_DIR:-$root/sdks/native/target}/$target/debug/$library" "$out/$prefix/$library"
    if [ -n "$compiler" ]; then
        "$compiler-strip" --strip-debug "$out/$prefix/$library"
    else
        strip -S "$out/$prefix/$library"
    fi
done
echo "wrote JNA resources to $out"

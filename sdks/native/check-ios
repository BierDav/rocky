#!/bin/sh
# Builds the two supported iOS ABI targets, each with and without iroh.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
[ "$(uname -s)" = Darwin ] || {
    echo 'check-ios: requires macOS and Xcode' >&2
    exit 1
}
xcrun --sdk iphoneos --show-sdk-path >/dev/null
xcrun --sdk iphonesimulator --show-sdk-path >/dev/null
# Match Kotlin/Native's iOS minimum for Rust and bundled C dependencies.
export IPHONEOS_DEPLOYMENT_TARGET=13.0
failed=0
for target in aarch64-apple-ios aarch64-apple-ios-sim; do
    if ! cargo build --manifest-path sdks/native/Cargo.toml --lib --target "$target" --no-default-features --locked; then
        echo "check-ios: $target without iroh failed" >&2
        failed=1
    fi
    if ! cargo build --manifest-path sdks/native/Cargo.toml --lib --target "$target" --locked; then
        echo "check-ios: $target with iroh failed" >&2
        failed=1
    fi
done

exit "$failed"

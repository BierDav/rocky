#!/usr/bin/env python3
"""Build dedicated discovery probes; installs and device actions are separate."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess

SOURCE = Path(__file__).resolve().parent
ROOT = SOURCE.parents[3]
OUT = ROOT / "local/discovery-probe"


def run(name, *command, environment=None):
    print(name, flush=True)
    with (OUT / (name + ".log")).open("w") as log:
        result = subprocess.run(command, cwd=ROOT, env=environment, stdout=log, stderr=subprocess.STDOUT, check=False)
    if result.returncode:
        print((OUT / (name + ".log")).read_text()[-12000:], flush=True)
        raise RuntimeError(name + " failed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--team", required=True, help="Apple development team for the dedicated probe")
    parser.add_argument("--ios-device", required=True)
    parser.add_argument("--bindgen", type=Path, help="Existing Rocky UniFFI 0.32.2 generator; otherwise builds it")
    parser.add_argument("--ndk", type=Path, default=Path.home() / "Library/Android/sdk/ndk/28.2.13676358")
    args = parser.parse_args()
    OUT.mkdir(parents=True, exist_ok=True)
    manifest = SOURCE / "Cargo.toml"
    environment = dict(os.environ, CARGO_TARGET_DIR=str(ROOT / "target"), IPHONEOS_DEPLOYMENT_TARGET="13.0")
    run("host", "cargo", "build", "--manifest-path", str(manifest), "--locked", environment=environment)
    if args.bindgen is None:
        run("bindgen", "cargo", "build", "--manifest-path", "sdks/native/Cargo.toml", "--features", "bindgen", "--bin", "rocky-bindgen", "--locked")
    bindgen = args.bindgen or ROOT / "sdks/native/target/debug/rocky-bindgen"
    generated = OUT / "generated"
    run("generate", str(bindgen), "generate", "--library", str(ROOT / "target/debug/librocky_discovery_probe.dylib"), "--language", "swift", "--language", "kotlin", "--out-dir", str(generated))
    run("ios-rust", "cargo", "build", "--manifest-path", str(manifest), "--target", "aarch64-apple-ios", "--locked", environment=environment)
    ios = OUT / "ios"
    ios.mkdir(exist_ok=True)
    for name in ("App.swift", "Info.plist"):
        shutil.copy2(SOURCE / "ios" / name, ios / name)
    shutil.copytree(generated, ios / "generated", dirs_exist_ok=True)
    shutil.copy2(generated / "rocky_discovery_probeFFI.modulemap", ios / "generated/module.modulemap")
    project = ios / "Probe.xcodeproj"
    project.mkdir(exist_ok=True)
    shutil.copy2(SOURCE / "ios/project.pbxproj", project / "project.pbxproj")
    run("ios-app", "xcodebuild", "-project", str(project), "-scheme", "RockyDiscoveryProbe", "-configuration", "Debug", "-destination", "id=" + args.ios_device, "-derivedDataPath", str(OUT / "xcode"), "-allowProvisioningUpdates", "DEVELOPMENT_TEAM=" + args.team, "OTHER_LDFLAGS=" + str(ROOT / "target/aarch64-apple-ios/debug/librocky_discovery_probe.a") + " -framework Security -framework CoreFoundation -framework SystemConfiguration -framework Network -liconv", "build")
    ndk_bin = next((args.ndk / "toolchains/llvm/prebuilt").iterdir()) / "bin"
    android_env = dict(environment)
    compiler = str(ndk_bin / "aarch64-linux-android26-clang")
    android_env.update(CC_aarch64_linux_android=compiler, AR_aarch64_linux_android=str(ndk_bin / "llvm-ar"), CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER=compiler)
    run("android-rust", "cargo", "build", "--manifest-path", str(manifest), "--target", "aarch64-linux-android", "--locked", environment=android_env)
    android = OUT / "android"
    shutil.copytree(SOURCE / "android", android, dirs_exist_ok=True)
    bindings = android / "app/src/main/kotlin/uniffi"
    bindings.mkdir(parents=True, exist_ok=True)
    for binding in generated.rglob("*.kt"):
        shutil.copy2(binding, bindings / binding.name)
    libraries = android / "app/src/main/jniLibs/arm64-v8a"
    libraries.mkdir(parents=True, exist_ok=True)
    shutil.copy2(ROOT / "target/aarch64-linux-android/debug/librocky_discovery_probe.so", libraries)
    android_home = os.environ.get("ANDROID_HOME", str(Path.home() / "Library/Android/sdk"))
    (android / "local.properties").write_text("sdk.dir=" + android_home + "\n")
    run("android-app", str(ROOT / "sdks/kotlin/gradlew"), "-p", str(android), ":app:assembleDebug")
    print("iOS:", OUT / "xcode/Build/Products/Debug-iphoneos/RockyDiscoveryProbe.app")
    print("Android:", android / "app/build/outputs/apk/debug/app-debug.apk")


if __name__ == "__main__":
    main()

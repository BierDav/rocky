#!/bin/sh
# Phase 15's simulator gate: local discovery follows the lifecycle, and a
# simulator and a host process find each other over mDNS.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
export IPHONEOS_DEPLOYMENT_TARGET=13.0
./kotlin test -p iosSimulatorArm64 -m rocky-core --include-classes rocky.SimulatorDiscoveryTest
binary=$(find "$repo_root/build" -type f -name '*.kexe' -path '*rocky-core*' -path '*Test*' ! -path '*.dSYM/*' | head -n 1)
[ -n "$binary" ] || { echo 'cannot find rocky-core simulator test executable' >&2; exit 1; }
cargo test --locked -p rocky-sdk --test discovery --no-run
# Kotlin shuts down its simulator after tests; boot one for the paired run.
selection=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
devices = [d for ds in json.load(sys.stdin)["devices"].values() for d in ds if d["isAvailable"] and "iPhone" in d["name"]]
device = next((d for d in devices if d["state"] == "Booted"), devices[0])
print(device["udid"], "yes" if device["state"] != "Booted" else "no")
')
simulator=${selection%% *}
started=${selection##* }
if [ "$started" = yes ]; then xcrun simctl boot "$simulator"; fi
root=$(mktemp -d "${TMPDIR:-/tmp}/rocky-ios-discovery.XXXXXX")
host=
cleanup() {
    [ -z "$host" ] || kill "$host" 2>/dev/null || true
    if [ "$started" = yes ]; then xcrun simctl shutdown "$simulator"; fi
    rm -rf "$root"
}
trap cleanup EXIT
xcrun simctl bootstatus "$simulator" -b
ROCKY_DISCOVERY_ROOT="$root" cargo test --locked -p rocky-sdk --test discovery -- \
    --exact simulator_peer --ignored --nocapture &
host=$!
SIMCTL_CHILD_ROCKY_DISCOVERY_ROOT="$root" xcrun simctl spawn "$simulator" "$binary" \
    --ktest_filter=rocky.SimulatorDiscoveryTest.simulatorAndHostProcessFindEachOtherOverMdns
wait "$host"
host=
[ -s "$root/host-found" ] && [ -s "$root/simulator-found" ] || {
    echo 'the simulator and the host did not both report a local peer' >&2
    exit 1
}
echo "iOS simulator discovery: host found $(cat "$root/simulator-found" | cut -c1-16)…, both over mDNS"

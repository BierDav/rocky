#!/bin/sh
# Simulator crash probes before, inside and after COMMIT, before its reply.
set -eu
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
export IPHONEOS_DEPLOYMENT_TARGET=13.0
sdks/kotlin/gradlew -p sdks/kotlin -Procky.qualification=true :rocky-core:iosSimulatorArm64Test \
    --tests rocky.SecretsTest --tests 'rocky.Ios*Test'
binary="$repo_root/sdks/kotlin/rocky-core/build/bin/iosSimulatorArm64/debugTest/test.kexe"
[ -x "$binary" ] || { echo 'cannot find rocky-core simulator test executable' >&2; exit 1; }
# Gradle shuts down its simulator after tests; boot one for the subprocess probes.
selection=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
devices = [d for ds in json.load(sys.stdin)["devices"].values() for d in ds if d["isAvailable"] and "iPhone" in d["name"]]
device = next((d for d in devices if d["state"] == "Booted"), devices[0])
print(device["udid"], "yes" if device["state"] != "Booted" else "no")
')
simulator=${selection%% *}
started=${selection##* }
if [ "$started" = yes ]; then xcrun simctl boot "$simulator"; fi
trap 'if [ "$started" = yes ]; then xcrun simctl shutdown "$simulator"; fi' EXIT
xcrun simctl bootstatus "$simulator" -b
mkdir -p local/phase18-evidence
xcrun simctl spawn "$simulator" "$binary" --ktest_logger=GTEST \
    '--ktest_filter=rocky.SecretsTest.*:rocky.Ios*Test.*' > local/phase18-evidence/ios-test-results.log
python3 scripts/ci/ios-test-results local/phase18-evidence/ios-test-results.log
for point in before during after; do
    root=$(mktemp -d "${TMPDIR:-/tmp}/rocky-crash-$point.XXXXXX")
    export SIMCTL_CHILD_ROCKY_CRASH_ROOT="$root"
    SIMCTL_CHILD_ROCKY_CRASH_MODE=prepare xcrun simctl spawn "$simulator" "$binary" --ktest_filter=rocky.IosCrashProbeTest.committedWriteReopensAndReconciles
    status=0
    SIMCTL_CHILD_ROCKY_SQL_KILL_AT=$point SIMCTL_CHILD_ROCKY_CRASH_MODE=write xcrun simctl spawn "$simulator" "$binary" \
        --ktest_filter=rocky.IosCrashProbeTest.committedWriteReopensAndReconciles || status=$?
    [ "$status" -eq 87 ] || { echo "crash $point returned $status, expected 87" >&2; exit 1; }
    expected=no
    [ "$point" != after ] || expected=yes
    SIMCTL_CHILD_ROCKY_CRASH_EXPECT_COMMIT=$expected SIMCTL_CHILD_ROCKY_CRASH_MODE=verify xcrun simctl spawn "$simulator" "$binary" \
        --ktest_filter=rocky.IosCrashProbeTest.committedWriteReopensAndReconciles
    echo "crash $point: recovered; committed=$expected"
    rm -rf "$root"
done

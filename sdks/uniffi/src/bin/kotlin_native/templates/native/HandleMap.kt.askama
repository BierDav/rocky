internal class UniffiHandleMap<T: Any> {
    private val mapLock = kotlinx.atomicfu.locks.ReentrantLock()
    private val map = HashMap<Long, T>()

    // We'll start at 1L to prevent "Null Pointers" in native's `interpretCPointer`
    private val counter: kotlinx.atomicfu.AtomicLong = kotlinx.atomicfu.atomic(1L)

    internal val size: Int
        get() = syncAccess { map.size }

    // Insert a new object into the handle map and get a handle for it
    internal fun insert(obj: T): Long {
        val handle = counter.getAndAdd(2)
        syncAccess { map.put(handle, obj); uniffiMapHandles.incrementAndGet() }
        return handle
    }

    // Get an object from the handle map
    internal fun get(handle: Long): T {
        return syncAccess { map.get(handle) } ?: throw InternalException("UniffiHandleMap.get: Invalid handle")
    }

    internal fun clone(handle: Long): Long = insert(get(handle))

    // Remove an entry from the handlemap and get the Kotlin object back
    internal fun remove(handle: Long): T {
        return syncAccess { map.remove(handle)?.also { uniffiMapHandles.decrementAndGet() } } ?: throw InternalException("UniffiHandleMap.remove: Invalid handle")
    }

    internal fun <T> syncAccess(block: () -> T): T {
        mapLock.lock()
        try {
            return block()
        } finally {
            mapLock.unlock()
        }
    }
}

internal val uniffiMapHandles = kotlinx.atomicfu.atomic(0)
internal val uniffiObjectHandles = kotlinx.atomicfu.atomic(0)
internal val uniffiFutureHandles = kotlinx.atomicfu.atomic(0)
/** Counts owned Rust objects, callback handles, pending continuations and native futures. */
public fun bindingLiveHandles(): Int = uniffiMapHandles.value + uniffiObjectHandles.value + uniffiFutureHandles.value
